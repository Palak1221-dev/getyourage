---
import "../styles/global.css";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	robots?: string;
	hideHeader?: boolean;
	hideFooter?: boolean;
	/** Suppress all third-party analytics (Google Analytics + Microsoft Clarity
	 * session recording) on pages where users paste private content. Clarity is
	 * a session recorder — it captures the DOM and typed/pasted text, so it must
	 * never run where document content is entered. */
	privacy?: boolean;
}

const { 
	title = "Age Calculator - Tooltails.com", 
	description = "Calculate your exact age in years, months, days, and more. Free, fast, and modern age calculator.",
	image = "/og-image.png",
	robots = "index, follow",
	hideHeader = false,
	hideFooter = false,
	privacy = false
} = Astro.props;

const rawPath = Astro.url.pathname;
const pathnameWithSlash = (rawPath.endsWith('/') || rawPath.split('/').pop()?.includes('.'))
	? rawPath
	: `${rawPath}/`;
const canonicalURL = new URL(pathnameWithSlash, Astro.site || 'https://tooltails.com');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- Modern SVG Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<!-- Fallback for older browsers -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
		<!-- Theme Color for mobile browsers -->
		<meta name="theme-color" content="#2563EB" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="light dark" />
		
		<meta name="generator" content={Astro.generator} />
		
		<meta name="google-site-verification" content="HqIOnKHLOIvy2wNB3_XF45mMl8q6q7oywDCWVqvFlUQ" />
		
		{!privacy && (
			<>
				<!-- Google tag (gtag.js) -->
				<script async src="https://www.googletagmanager.com/gtag/js?id=G-KR0XE0DH6F"></script>
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());

					gtag('config', 'G-KR0XE0DH6F');
				</script>

				<!-- Microsoft Clarity -->
				<script type="text/javascript" is:inline>
					(function(c,l,a,r,i,t,y){
						c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
						t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
						y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
					})(window, document, "clarity", "script", "xaww0799qh");
				</script>
			</>
		)}

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		
		<!-- Preconnect for third-party origins -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		{!privacy && (
			<>
				<link rel="preconnect" href="https://www.googletagmanager.com" />
				<link rel="preconnect" href="https://www.clarity.ms" />
			</>
		)}
		<link rel="preconnect" href="https://cdn.jsdelivr.net" />
		
		<!-- Storefront & Editorial Fonts -->
		<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Instrument+Serif:ital@0;1&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		
		<!-- Preload critical fonts -->
		<link rel="preload" as="font" href="https://cdn.jsdelivr.net/font-geist/1.0.0/Geist-Variable.woff2" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" as="font" href="https://cdn.jsdelivr.net/font-geist/1.0.0/GeistMono-Variable.woff2" type="font/woff2" crossorigin="anonymous" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={Astro.url.origin + image} />
		<meta property="og:site_name" content="Tooltails" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={Astro.url.origin + image} />
		<meta property="twitter:site" content="@tooltails" />
		
		<link rel="canonical" href={canonicalURL} />
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.setAttribute('data-theme', 'light');
			} else {
				document.documentElement.setAttribute('data-theme', 'dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
		<slot name="head" />

		<style is:global>
			@font-face {
				font-family: 'Geist';
				src: url('https://cdn.jsdelivr.net/font-geist/1.0.0/Geist-Variable.woff2') format('woff2');
				font-weight: 100 900;
				font-display: swap;
			}
			@font-face {
				font-family: 'Geist Mono';
				src: url('https://cdn.jsdelivr.net/font-geist/1.0.0/GeistMono-Variable.woff2') format('woff2');
				font-weight: 100 900;
				font-display: swap;
			}
      
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
      }
      
      [data-theme="light"] { color-scheme: light; }
      [data-theme="dark"] { color-scheme: dark; }
		</style>
	</head>
	<body class="relative min-h-screen flex flex-col" style="touch-action: manipulation">
		<!-- Skip to main content -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-canvas focus:text-ink focus:border focus:border-hairline focus:rounded-lg focus:shadow-md">
			Skip to main content
		</a>
		
		<!-- Mesh Gradient Background -->
		<div class="mesh-gradient absolute top-0 left-0 w-full h-[600px] -z-10 pointer-events-none"></div>
		
		{!hideHeader && <Header />}
		
		<main id="main-content" class="flex-grow">
			<slot />
		</main>

		{!hideFooter && <Footer />}
	</body>
</html>
