---
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import Input from "../ui/Input.astro";
---

<div class="bg-canvas border border-hairline-strong rounded-[2.5rem] shadow-md overflow-hidden p-6 sm:p-8 md:p-10 relative group transition-all duration-300 focus-within:shadow-xl focus-within:border-link focus-within:ring-4 focus-within:ring-link/20">
  <div class="absolute top-0 right-0 w-80 h-80 bg-link/5 rounded-full translate-x-1/3 -translate-y-1/3 blur-3xl group-focus-within:bg-link/15 transition-colors duration-500 pointer-events-none"></div>
  <div class="absolute top-0 left-0 w-full h-1 bg-link opacity-80 group-hover:opacity-100 transition-opacity"></div>

  <!-- Workspace Header / Toolbar -->
  <div class="flex items-center justify-between gap-3 pb-6 mb-6 border-b border-hairline relative z-10">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-full bg-link/10 text-link flex items-center justify-center shadow-inner">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 10"/></svg>
      </div>
      <div>
        <span class="text-[11px] font-extrabold text-ink uppercase tracking-wider block leading-none">Future Age Projection</span>
        <span class="text-[10px] text-mute font-medium leading-none">Project your exact age on any date in time</span>
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas-soft border border-hairline text-mute text-[10px] font-bold uppercase tracking-wider">
      <span class="w-1.5 h-1.5 rounded-full bg-link"></span>
      Client-Side
    </span>
  </div>

  <form id="future-form" class="space-y-6 relative z-10">
    <!-- Date of Birth & Future Date timeline capsules -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
      <!-- Date of Birth Capsule -->
      <div class="bg-canvas-soft/40 border border-hairline rounded-2xl p-4 sm:p-5 relative">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-link/10 text-link text-xs font-bold flex items-center justify-center">1</span>
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-ink">Date of Birth</h3>
        </div>
        <div class="grid grid-cols-3 gap-2.5">
          <Input label="Day" type="number" id="dob-day" placeholder="01" min="1" max="31" required />
          <Input label="Month" type="number" id="dob-month" placeholder="01" min="1" max="12" required />
          <Input label="Year" type="number" id="dob-year" placeholder="1995" min={new Date().getFullYear() - 130} required />
        </div>
      </div>

      <!-- Future Date Capsule -->
      <div class="bg-canvas-soft/40 border border-hairline rounded-2xl p-4 sm:p-5 relative">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-link/10 text-link text-xs font-bold flex items-center justify-center">2</span>
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-ink">Future Date</h3>
        </div>
        <div class="grid grid-cols-3 gap-2.5">
          <Input label="Day" type="number" id="f-day" placeholder="01" min="1" max="31" required />
          <Input label="Month" type="number" id="f-month" placeholder="01" min="1" max="12" required />
          <Input label="Year" type="number" id="f-year" placeholder="2050" min={new Date().getFullYear() - 130} required />
        </div>
      </div>
    </div>

    <!-- Error Message Container -->
    <div id="error-message" class="hidden text-sm text-error font-medium p-4 bg-error/10 border border-error/20 rounded-2xl">
    </div>

    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <Button type="submit" class="flex-grow py-3.5 px-8 rounded-full shadow-lg shadow-link/20 font-bold text-sm sm:text-base justify-center active:scale-98 transition-all cursor-pointer">Calculate Future Age</Button>
      <Button variant="secondary" id="reset-btn" class="py-3.5 px-6 rounded-full text-sm font-semibold justify-center transition-all cursor-pointer">Reset</Button>
    </div>
  </form>

  <div id="result-container" class="mt-10 pt-8 border-t border-hairline hidden space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500 scroll-mt-24 relative z-10">
    <div class="bg-canvas-soft/40 border border-hairline p-6 sm:p-8 rounded-[2rem] text-center relative overflow-hidden group/hero">
      <div class="absolute top-0 left-0 w-full h-1 bg-link opacity-60"></div>
      <h3 class="text-mute font-bold text-[10px] sm:text-[11px] uppercase tracking-[0.25em] mb-4">Age On That Date Will Be</h3>
      <div class="flex flex-wrap justify-center items-baseline gap-x-4 sm:gap-x-6 gap-y-2">
        <div class="flex items-baseline gap-1.5">
          <span id="res-years" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-link leading-none">0</span>
          <span class="text-base sm:text-lg font-bold text-mute uppercase tracking-wider">years</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span id="res-months" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-link leading-none">0</span>
          <span class="text-base sm:text-lg font-bold text-mute uppercase tracking-wider">months</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span id="res-days" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-link leading-none">0</span>
          <span class="text-base sm:text-lg font-bold text-mute uppercase tracking-wider">days</span>
        </div>
      </div>
    </div>
    
    <!-- Additional Statistics Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
      <div class="bg-canvas border border-hairline p-4 sm:p-5 rounded-[1.75rem] shadow-sm relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-link/40 group/metric">
        <div class="absolute top-0 left-0 w-full h-1 bg-link opacity-60 group-hover/metric:opacity-100 transition-opacity"></div>
        <span class="block text-[9px] sm:text-[10px] font-bold text-mute uppercase tracking-widest leading-none mb-2">Total Months</span>
        <span id="res-total-months" class="text-2xl sm:text-3xl font-extrabold tracking-tighter text-ink">0</span>
      </div>
      <div class="bg-canvas border border-hairline p-4 sm:p-5 rounded-[1.75rem] shadow-sm relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-link/40 group/metric">
        <div class="absolute top-0 left-0 w-full h-1 bg-link opacity-60 group-hover/metric:opacity-100 transition-opacity"></div>
        <span class="block text-[9px] sm:text-[10px] font-bold text-mute uppercase tracking-widest leading-none mb-2">Total Weeks</span>
        <span id="res-total-weeks" class="text-2xl sm:text-3xl font-extrabold tracking-tighter text-ink">0</span>
      </div>
      <div class="bg-canvas border border-hairline p-4 sm:p-5 rounded-[1.75rem] shadow-sm relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-link/40 group/metric">
        <div class="absolute top-0 left-0 w-full h-1 bg-link opacity-60 group-hover/metric:opacity-100 transition-opacity"></div>
        <span class="block text-[9px] sm:text-[10px] font-bold text-mute uppercase tracking-widest leading-none mb-2">Total Days</span>
        <span id="res-total-days" class="text-2xl sm:text-3xl font-extrabold tracking-tighter text-ink">0</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateAge } from "../../utils/dateUtils";
  import { setQueryParams, getQueryParams } from "../../utils/seoUtils";

  const form = document.getElementById('future-form') as HTMLFormElement;
  const resultContainer = document.getElementById('result-container');
  const errorMessage = document.getElementById('error-message');
  
  const resYears = document.getElementById('res-years');
  const resMonths = document.getElementById('res-months');
  const resDays = document.getElementById('res-days');
  const resTotalMonths = document.getElementById('res-total-months');
  const resTotalWeeks = document.getElementById('res-total-weeks');
  const resTotalDays = document.getElementById('res-total-days');

  const showError = (msg: string) => {
    if (errorMessage) {
      errorMessage.textContent = msg;
      errorMessage.classList.remove('hidden');
    }
  };

  const hideError = () => {
    if (errorMessage) {
      errorMessage.classList.add('hidden');
    }
  };

  const updateUI = () => {
    hideError();
    const d = {
      d: parseInt((document.getElementById('dob-day') as HTMLInputElement).value),
      m: parseInt((document.getElementById('dob-month') as HTMLInputElement).value),
      y: parseInt((document.getElementById('dob-year') as HTMLInputElement).value)
    };
    const f = {
      d: parseInt((document.getElementById('f-day') as HTMLInputElement).value),
      m: parseInt((document.getElementById('f-month') as HTMLInputElement).value),
      y: parseInt((document.getElementById('f-year') as HTMLInputElement).value)
    };

    const dob = new Date(d.y, d.m - 1, d.d);
    const future = new Date(f.y, f.m - 1, f.d);

    if (future < dob) {
      showError("The future date cannot be earlier than the date of birth.");
      return;
    }

    const result = calculateAge(dob, future);
    const totalMonthsVal = result.years * 12 + result.months;

    if (resYears) resYears.textContent = result.years.toString();
    if (resMonths) resMonths.textContent = result.months.toString();
    if (resDays) resDays.textContent = result.days.toString();
    if (resTotalMonths) resTotalMonths.textContent = totalMonthsVal.toLocaleString();
    if (resTotalWeeks) resTotalWeeks.textContent = result.totalWeeks.toLocaleString();
    if (resTotalDays) resTotalDays.textContent = result.totalDays.toLocaleString();

    resultContainer?.classList.remove('hidden');
    resultContainer?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    setQueryParams({ 
      dd: d.d.toString(), dm: d.m.toString(), dy: d.y.toString(),
      fd: f.d.toString(), fm: f.m.toString(), fy: f.y.toString()
    });
  };

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    updateUI();
  });

  document.getElementById('reset-btn')?.addEventListener('click', () => {
    form.reset();
    hideError();
    resultContainer?.classList.add('hidden');
    setQueryParams({ 
      dd: '', dm: '', dy: '',
      fd: '', fm: '', fy: ''
    });
  });

  const params = getQueryParams();
  if (params.dy && params.fy) {
    (document.getElementById('dob-day') as HTMLInputElement).value = params.dd;
    (document.getElementById('dob-month') as HTMLInputElement).value = params.dm;
    (document.getElementById('dob-year') as HTMLInputElement).value = params.dy;
    (document.getElementById('f-day') as HTMLInputElement).value = params.fd;
    (document.getElementById('f-month') as HTMLInputElement).value = params.fm;
    (document.getElementById('f-year') as HTMLInputElement).value = params.fy;
    updateUI();
  }
</script>
