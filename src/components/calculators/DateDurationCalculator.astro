---
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import Input from "../ui/Input.astro";
---

<div class="bg-canvas border border-hairline-strong rounded-[2.5rem] shadow-md overflow-hidden p-6 sm:p-8 md:p-10 relative group transition-all duration-300 focus-within:shadow-xl focus-within:border-link focus-within:ring-4 focus-within:ring-link/20">
  <div class="absolute top-0 right-0 w-80 h-80 bg-link/5 rounded-full translate-x-1/3 -translate-y-1/3 blur-3xl group-focus-within:bg-link/15 transition-colors duration-500 pointer-events-none"></div>
  <div class="absolute top-0 left-0 w-full h-1 bg-link opacity-80 group-hover:opacity-100 transition-opacity"></div>

  <!-- Workspace Header / Toolbar -->
  <div class="flex items-center justify-between gap-3 pb-6 mb-6 border-b border-hairline relative z-10">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-full bg-link/10 text-link flex items-center justify-center shadow-inner">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <span class="text-[11px] font-extrabold text-ink uppercase tracking-wider block leading-none">Date Duration Span</span>
        <span class="text-[10px] text-mute font-medium leading-none">Compute precise elapsed time between two points</span>
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas-soft border border-hairline text-mute text-[10px] font-bold uppercase tracking-wider">
      <span class="w-1.5 h-1.5 rounded-full bg-link"></span>
      Client-Side
    </span>
  </div>

  <form id="duration-form" class="space-y-6 relative z-10">
    <!-- Start Date & End Date timeline capsules -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
      <!-- Start Date Capsule -->
      <div class="bg-canvas-soft/40 border border-hairline rounded-2xl p-4 sm:p-5 relative">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-link/10 text-link text-xs font-bold flex items-center justify-center">S</span>
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-ink">Start Date</h3>
        </div>
        <div class="grid grid-cols-3 gap-2.5">
          <Input label="Day" type="number" id="s-day" placeholder="01" min="1" max="31" required />
          <Input label="Month" type="number" id="s-month" placeholder="01" min="1" max="12" required />
          <Input label="Year" type="number" id="s-year" placeholder="1995" min={new Date().getFullYear() - 130} required />
        </div>
      </div>

      <!-- End Date Capsule -->
      <div class="bg-canvas-soft/40 border border-hairline rounded-2xl p-4 sm:p-5 relative">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-link/10 text-link text-xs font-bold flex items-center justify-center">E</span>
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-ink">End Date</h3>
        </div>
        <div class="grid grid-cols-3 gap-2.5">
          <Input label="Day" type="number" id="e-day" placeholder="01" min="1" max="31" required />
          <Input label="Month" type="number" id="e-month" placeholder="01" min="1" max="12" required />
          <Input label="Year" type="number" id="e-year" placeholder="1995" min="1900" required />
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <Button type="submit" class="flex-grow py-3.5 px-8 rounded-full shadow-lg shadow-link/20 font-bold text-sm sm:text-base justify-center active:scale-98 transition-all cursor-pointer">Calculate Duration</Button>
      <Button variant="secondary" id="reset-btn" class="py-3.5 px-6 rounded-full text-sm font-semibold justify-center transition-all cursor-pointer">Reset</Button>
    </div>
  </form>

  <div id="result-container" class="mt-10 pt-8 border-t border-hairline hidden space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500 scroll-mt-24 relative z-10">
    <div class="bg-canvas-soft/40 border border-hairline p-6 sm:p-8 rounded-[2rem] text-center relative overflow-hidden group/hero">
      <div class="absolute top-0 left-0 w-full h-1 bg-link opacity-60"></div>
      <h3 class="text-mute font-bold text-[10px] sm:text-[11px] uppercase tracking-[0.25em] mb-4">The Duration Is</h3>
      <div class="flex flex-wrap justify-center items-baseline gap-x-4 sm:gap-x-6 gap-y-2">
        <div class="flex items-baseline gap-1.5">
          <span id="res-years" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-link leading-none">0</span>
          <span class="text-base sm:text-lg font-bold text-mute uppercase tracking-wider">years</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span id="res-months" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-link leading-none">0</span>
          <span class="text-base sm:text-lg font-bold text-mute uppercase tracking-wider">months</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span id="res-days" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-link leading-none">0</span>
          <span class="text-base sm:text-lg font-bold text-mute uppercase tracking-wider">days</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateAge } from "../../utils/dateUtils";
  import { setQueryParams, getQueryParams } from "../../utils/seoUtils";

  const form = document.getElementById('duration-form') as HTMLFormElement;
  const resultContainer = document.getElementById('result-container');
  const resYears = document.getElementById('res-years');
  const resMonths = document.getElementById('res-months');
  const resDays = document.getElementById('res-days');

  const updateUI = () => {
    const s = {
      d: parseInt((document.getElementById('s-day') as HTMLInputElement).value),
      m: parseInt((document.getElementById('s-month') as HTMLInputElement).value),
      y: parseInt((document.getElementById('s-year') as HTMLInputElement).value)
    };
    const e = {
      d: parseInt((document.getElementById('e-day') as HTMLInputElement).value),
      m: parseInt((document.getElementById('e-month') as HTMLInputElement).value),
      y: parseInt((document.getElementById('e-year') as HTMLInputElement).value)
    };

    const start = new Date(s.y, s.m - 1, s.d);
    const end = new Date(e.y, e.m - 1, e.d);
    const [earlier, later] = start < end ? [start, end] : [end, start];

    const result = calculateAge(earlier, later);

    if (resYears) resYears.textContent = result.years.toString();
    if (resMonths) resMonths.textContent = result.months.toString();
    if (resDays) resDays.textContent = result.days.toString();

    resultContainer?.classList.remove('hidden');

    setQueryParams({ 
      sd: s.d.toString(), sm: s.m.toString(), sy: s.y.toString(),
      ed: e.d.toString(), em: e.m.toString(), ey: e.y.toString()
    });
  };

  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    updateUI();
  });

  document.getElementById('reset-btn')?.addEventListener('click', () => {
    form.reset();
    resultContainer?.classList.add('hidden');
    setQueryParams({ 
      sd: '', sm: '', sy: '',
      ed: '', em: '', ey: ''
    });
  });

  const params = getQueryParams();
  if (params.sy && params.ey) {
    (document.getElementById('s-day') as HTMLInputElement).value = params.sd;
    (document.getElementById('s-month') as HTMLInputElement).value = params.sm;
    (document.getElementById('s-year') as HTMLInputElement).value = params.sy;
    (document.getElementById('e-day') as HTMLInputElement).value = params.ed;
    (document.getElementById('e-month') as HTMLInputElement).value = params.em;
    (document.getElementById('e-year') as HTMLInputElement).value = params.ey;
    updateUI();
  }
</script>
