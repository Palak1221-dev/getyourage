---
// System Comparison Drawer & Bar Component
---

<!-- FLOATING COMPARISON BAR AT BOTTOM OF MARKETPLACE -->
<div id="comparison-bar" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-40 bg-white/95 backdrop-blur-md border border-[#EAE3D8] shadow-2xl rounded-full px-5 py-3 flex items-center gap-4 opacity-0 translate-y-10 pointer-events-none transition-all duration-300" role="region" aria-label="System comparison bar">
  
  <div class="flex items-center gap-2">
    <span class="text-xs font-bold text-stone-900 font-serif">⚖️ System Comparison:</span>
    <span id="compare-count-badge" class="text-xs font-bold text-blue-700 bg-blue-100 px-2 py-0.5 rounded-full">0/3 Selected</span>
  </div>

  <div id="compare-items-row" class="hidden sm:flex items-center gap-2">
    <!-- Selected items avatars render here via JS -->
  </div>

  <div class="flex items-center gap-2">
    <button id="trigger-compare-modal" class="px-4 py-1.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-xs transition-all cursor-pointer">
      Compare Now →
    </button>
    <button id="clear-compare-btn" class="text-xs font-semibold text-stone-400 hover:text-stone-700 cursor-pointer">
      Clear
    </button>
  </div>
</div>

<!-- SIDE-BY-SIDE SYSTEM COMPARISON MODAL -->
<div id="comparison-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300" role="dialog" aria-modal="true" aria-labelledby="compare-modal-title">
  
  <div id="compare-backdrop" class="absolute inset-0 bg-stone-900/60 backdrop-blur-xs transition-opacity duration-300"></div>

  <div class="relative w-full max-w-4xl bg-[#FAF7F2] rounded-3xl border border-[#EAE3D8] shadow-2xl overflow-hidden p-6 md:p-8 space-y-6 max-h-[90vh] overflow-y-auto z-10">
    
    <button id="close-compare-modal" class="absolute top-4 right-4 z-20 w-8 h-8 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-600 hover:text-stone-900 shadow-xs" aria-label="Close modal">
      ✕
    </button>

    <div class="text-center max-w-lg mx-auto space-y-2">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-700 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">
        ⚖️ Side-by-Side Comparison
      </span>
      <h2 id="compare-modal-title" class="text-2xl sm:text-3xl font-bold font-serif text-stone-900">Compare Selected Productivity Systems</h2>
      <p class="text-xs text-stone-500 font-medium">Evaluate layout features, file formats, and customization depth before compiling.</p>
    </div>

    <!-- Comparison Table Grid -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-[#EAE3D8]">
            <th class="py-3 px-4 text-stone-400 uppercase tracking-wider text-[10px] font-bold w-1/4">Feature</th>
            <th class="py-3 px-4 font-bold text-stone-900 font-serif text-sm text-center bg-white rounded-t-xl border-x border-t border-[#EAE3D8]">System 01</th>
            <th class="py-3 px-4 font-bold text-stone-900 font-serif text-sm text-center bg-white rounded-t-xl border-x border-t border-[#EAE3D8]">System 02</th>
            <th class="py-3 px-4 font-bold text-stone-900 font-serif text-sm text-center bg-white rounded-t-xl border-x border-t border-[#EAE3D8]">System 03</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#EAE3D8]">
          <tr>
            <td class="py-3 px-4 font-bold text-stone-700">Target Focus</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8]">Exams & Study Spreads</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8]">Time Blocking & Deep Work</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8]">Daily Mindfulness & Habits</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-stone-700">Customization Depth</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-700 font-bold">High (Name + Class List)</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-700 font-bold">High (Name + Time Slot)</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-700 font-bold">High (Name + 30-Day Goal)</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-stone-700">Vector Print Ready</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-stone-700">GoodNotes / iPad Ready</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-stone-700">Lifetime Updates</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
            <td class="py-3 px-4 text-center bg-white border-x border-[#EAE3D8] text-emerald-600 font-bold">✓ Included</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-stone-700">Price</td>
            <td class="py-3 px-4 text-center bg-white border-x border-b border-[#EAE3D8] font-bold text-stone-900 font-heading text-sm">$19.99</td>
            <td class="py-3 px-4 text-center bg-white border-x border-b border-[#EAE3D8] font-bold text-stone-900 font-heading text-sm">$19.99</td>
            <td class="py-3 px-4 text-center bg-white border-x border-b border-[#EAE3D8] font-bold text-stone-900 font-heading text-sm">$19.99</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="flex justify-end pt-2">
      <button id="close-modal-bottom-btn" class="px-6 py-2.5 rounded-full bg-stone-900 text-white font-bold text-xs shadow-xs">
        Back to Marketplace
      </button>
    </div>

  </div>
</div>

<script>
// Comparison System Logic
const compareBar = document.getElementById('comparison-bar');
const compareModal = document.getElementById('comparison-modal');
const triggerBtn = document.getElementById('trigger-compare-modal');
const closeBtn = document.getElementById('close-compare-modal');
const closeBottomBtn = document.getElementById('close-modal-bottom-btn');
const backdrop = document.getElementById('compare-backdrop');
const badge = document.getElementById('compare-count-badge');
const clearBtn = document.getElementById('clear-compare-btn');

let selectedItems: string[] = [];

(window as any).toggleCompareItem = function(id: string) {
  const idx = selectedItems.indexOf(id);
  if (idx >= 0) {
    selectedItems.splice(idx, 1);
  } else {
    if (selectedItems.length >= 3) {
      alert('You can compare up to 3 planners at a time.');
      return;
    }
    selectedItems.push(id);
  }

  updateCompareUI();
};

function updateCompareUI() {
  if (!compareBar || !badge) return;
  badge.textContent = `${selectedItems.length}/3 Selected`;

  if (selectedItems.length > 0) {
    compareBar.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
  } else {
    compareBar.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
  }
}

if (clearBtn) {
  clearBtn.addEventListener('click', () => {
    selectedItems = [];
    updateCompareUI();
  });
}

function openCompareModal() {
  if (!compareModal) return;
  compareModal.classList.remove('opacity-0', 'pointer-events-none');
}

function closeCompareModal() {
  if (!compareModal) return;
  compareModal.classList.add('opacity-0', 'pointer-events-none');
}

if (triggerBtn) triggerBtn.addEventListener('click', openCompareModal);
if (closeBtn) closeBtn.addEventListener('click', closeCompareModal);
if (closeBottomBtn) closeBottomBtn.addEventListener('click', closeCompareModal);
if (backdrop) backdrop.addEventListener('click', closeCompareModal);
</script>
