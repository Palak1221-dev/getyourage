  </div>
</section>
)}

<!-- FAQ ACCORDION SECTION -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 border-t border-[var(--ds-border)]">
  <div class="text-center mb-16 space-y-3.5">
    <div class="w-8 h-[1.5px] mx-auto rounded-full" style="background:#2563eb;opacity:0.3"></div>
    <h2 class="text-3xl font-bold font-serif leading-tight text-stone-900" style="color:var(--ds-text);font-family:'Playfair Display',serif">Questions &amp; Answers</h2>
    <p class="text-xs text-stone-500 font-medium">Everything you need to know about the system.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {faqs.map(faq => (
      <div data-faq class="p-6.5 rounded-2xl space-y-2.5 transition-all shadow-2xs hover:border-[var(--ds-border-strong)]" style="background:var(--ds-bg-soft);border:1px solid var(--ds-border)">
        <h3 class="text-sm font-bold text-stone-900" style="color:var(--ds-text)">{faq.q}</h3>
        <p class="text-xs font-normal leading-relaxed text-stone-600" style="color:var(--ds-text-secondary)" set:html={renderFaqAnswer(faq.a)} />
      </div>
    ))}
  </div>
</section>

</div>

<script>
import { DigitalPlanner } from "../../scripts/planner-engine/digital-planner";
import { MasterYourDayPreview, getTheme as mydTheme } from "../../scripts/planner-engine/master-your-day-renderer";
import { WellnessJournalPreview, getTheme as wjTheme } from "../../scripts/planner-engine/wellness-journal-renderer";
import { SocialMediaDetoxPreview, getTheme as smdTheme } from "../../scripts/planner-engine/social-media-detox-renderer";

function initPlannerPreview() {
  const buyBtn = document.querySelector('button[data-product-id]') as HTMLButtonElement | null;
  if (!buyBtn) return;

  const productId = buyBtn.dataset.productId || '';
  const productTitle = buyBtn.dataset.productTitle || 'Personalized Planner';
  const productIcon = buyBtn.dataset.productIcon || '📅';
  const slug = buyBtn.dataset.productSlug || '';
  const suffix = productId;
  const container = document.getElementById(`digital-planner-preview-container-${suffix}`);

  const isMasterYourDay = slug === 'master-your-day' || productId === 'p7';
  const isWellnessJournal = slug === 'wellness-journal' || productId === 'p12';
  const isSocialMediaDetox = slug === 'social-media-detox' || productId === 'p10';

  if (container && !(container as any).__dp_mounted) {
    (container as any).__dp_mounted = true;
    try {
      const inputs = document.querySelectorAll(`input[id^="pf-"], select[id^="pf-"], textarea[id^="pf-"]`);
      const getValues = (): Record<string, string> => {
        const values: Record<string, string> = {};
        inputs.forEach(inp => {
          const el = inp as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
          const fid = el.dataset.fieldId;
          if (fid) values[fid] = el.value;
        });
        return values;
      };

      const getTheme = (): string => {
        return 'violet';
      };

      const dpOptions: any = { sidebar: false, coverEditablePreview: true };
      if (isMasterYourDay) {
        dpOptions.getPages = (values: any, theme: string, title?: string, icon?: string) => {
          const preview = new MasterYourDayPreview(values, mydTheme(theme), title, icon);
          return preview.getPageList();
        };
      } else if (isWellnessJournal) {
        dpOptions.getPages = (values: any, theme: string, title?: string, icon?: string) => {
          const preview = new WellnessJournalPreview(values, wjTheme(theme), title, icon);
          return preview.getPageList();
        };
      } else if (isSocialMediaDetox) {
        dpOptions.getPages = (values: any, theme: string, title?: string, icon?: string) => {
          const preview = new SocialMediaDetoxPreview(values, smdTheme(theme), title, icon);
          return preview.getPageList();
        };
      }

      const dp = new DigitalPlanner(container, getValues(), getTheme(), productTitle, productIcon, dpOptions);
      dp.mount();

      const updateLive = () => {
        dp.setValues(getValues(), getTheme(), productTitle, productIcon);
      };

      const highlightIndicator = (el: HTMLElement) => {
        const indicator = el.parentElement?.querySelector('.page-indicator') as HTMLElement | null;
        if (indicator) {
          indicator.classList.remove('indicator-highlight');
          void indicator.offsetWidth;
          indicator.classList.add('indicator-highlight');
        }
      };

      inputs.forEach(inp => {
        inp.addEventListener('input', updateLive);
        inp.addEventListener('change', updateLive);
        inp.addEventListener('input', () => highlightIndicator(inp));
        inp.addEventListener('change', () => highlightIndicator(inp));
      });
    } catch (e) {
      console.warn('Live preview initialized error:', e);
    }
  }

  buyBtn.addEventListener('click', () => {
    const pid = buyBtn.dataset.productId;
    const pslug = buyBtn.dataset.productSlug;
    const ptitle = buyBtn.dataset.productTitle;
    const picon = buyBtn.dataset.productIcon;

    const currency = (window as any).TooltailsCurrency?.getCurrency?.() || 'USD';
    const priceAttr = currency === 'INR' ? 'productPriceInr' : 'productPrice';
    const pprice = Number(buyBtn.dataset[priceAttr] ?? buyBtn.dataset.productPrice);

    let personalization: Record<string, string> = {};
    try {
      const inputs = document.querySelectorAll(`input[id^="pf-"], select[id^="pf-"], textarea[id^="pf-"]`);
      inputs.forEach(inp => {
        const el = inp as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        const fid = el.dataset.fieldId;
        if (fid) personalization[fid] = el.value;
      });
    } catch (e) {}

    const item = { id: pid, title: ptitle, slug: pslug, price: pprice, currency, icon: picon, quantity: 1, personalization };
    try {
      const existing = JSON.parse(localStorage.getItem('tt_cart') || '[]');
      existing.push(item);
      localStorage.setItem('tt_cart', JSON.stringify(existing));
    } catch (e) {
      localStorage.setItem('tt_cart', JSON.stringify([item]));
    }

    window.location.href = '/digital-store/checkout';
  });
}

if (document.readyState !== 'loading') {
  initPlannerPreview();
} else {
  document.addEventListener('DOMContentLoaded', initPlannerPreview);
}
document.addEventListener('astro:page-load', initPlannerPreview);
</script>

