---
export interface Props {
  category: string;
  icon: string;
  title: string;
  userName?: string;
  userGoal?: string;
  subjectList?: string[];
  accentColor?: string;
}

const { 
  category, 
  icon, 
  title, 
  userName = "Alex Johnson", 
  subjectList = ["Priority 1", "Priority 2", "Priority 3", "Priority 4"]
} = Astro.props;

const displayTitle = (title || 'Personalized System').replace('Pro', '').trim();
---

<div class="planner-stack-root relative w-full h-full min-h-[420px] max-h-[500px] select-none font-sans flex items-center justify-center">
  
  <!-- Soft Tooltails Purple Ambient Radial Glow -->
  <div class="absolute -inset-6 rounded-3xl opacity-40 blur-3xl pointer-events-none -z-20 bg-radial from-purple-200/40 via-indigo-100/20 to-transparent"></div>

  <!-- Tiny Sparkle Accent -->
  <div class="absolute -top-3 -right-2 z-40 pointer-events-none text-[#7C3AED] animate-pulse">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"/>
    </svg>
  </div>

  <!-- Realistic Soft Ground Ambient Shadow -->
  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[85%] h-7 bg-stone-950/12 blur-xl rounded-full pointer-events-none -z-10"></div>

  <!-- MOCKUP STACK CONTAINER -->
  <div class="relative w-[285px] sm:w-[325px] h-[385px] sm:h-[430px] flex items-center justify-center">

    <!-- 0. UNDERNEATH PAPER DECK STACK -->
    <div class="absolute -bottom-2 -left-2 w-[285px] sm:w-[325px] h-[385px] sm:h-[430px] bg-[#FAF7F2] rounded-xl border border-[#EDE4D8] shadow-sm transform -rotate-1 z-0 opacity-90"></div>

    <!-- 1. LEFT PEEK: PREMIUM MONTHLY PLANNER PAGE (18% Visible) -->
    <div class="absolute -top-3.5 -left-5 sm:-left-7 w-[275px] sm:w-[315px] h-[375px] sm:h-[420px] bg-[#FCFBF9] rounded-xl border border-[#EDE4D8] shadow-md shadow-stone-900/5 transform -rotate-4 z-5 opacity-95 p-5 flex flex-col justify-between overflow-hidden select-none">
      <div class="space-y-3">
        <div class="flex items-center justify-between border-b border-stone-200/50 pb-2">
          <span class="text-[8.5px] font-bold tracking-[0.25em] text-stone-500 uppercase font-mono">MONTHLY OVERVIEW</span>
          <span class="text-[8px] font-medium text-[#7C3AED]">OCTOBER</span>
        </div>
        <!-- Mini Calendar Matrix -->
        <div class="grid grid-cols-7 gap-1 text-center text-[7.5px] text-stone-400 font-mono pt-1">
          <span class="font-bold text-stone-600">M</span><span class="font-bold text-stone-600">T</span><span class="font-bold text-stone-600">W</span><span class="font-bold text-stone-600">T</span><span class="font-bold text-stone-600">F</span><span class="font-bold text-stone-600">S</span><span class="font-bold text-stone-600">S</span>
          <span>1</span><span>2</span><span>3</span><span class="bg-purple-100 text-[#7C3AED] font-bold rounded-xs">4</span><span>5</span><span>6</span><span>7</span>
        </div>
      </div>
      <span class="text-[8px] font-mono text-stone-300">PAGE 02</span>
    </div>

    <!-- 2. RIGHT PEEK: ELEGANT WEEKLY PLANNER PAGE (18% Visible) -->
    <div class="absolute -top-2 -right-5 sm:-right-7 w-[275px] sm:w-[315px] h-[375px] sm:h-[420px] bg-[#FCFBF9] rounded-xl border border-[#EDE4D8] shadow-md shadow-stone-900/5 transform rotate-4 z-10 opacity-95 p-5 flex flex-col justify-between overflow-hidden select-none">
      <div class="space-y-3">
        <div class="flex items-center justify-between border-b border-stone-200/50 pb-2">
          <span class="text-[8.5px] font-bold tracking-[0.25em] text-stone-500 uppercase font-mono">WEEKLY SPREAD</span>
          <span class="text-[8px] font-medium text-[#7C3AED]">WEEK 42</span>
        </div>
        <div class="space-y-2 text-[8px] font-mono text-stone-400">
          <div class="border-b border-stone-200/40 pb-1 flex justify-between">
            <span class="font-bold text-stone-600">MONDAY</span>
            <span class="text-stone-300">Deep Work</span>
          </div>
          <div class="border-b border-stone-200/40 pb-1 flex justify-between">
            <span class="font-bold text-stone-600">TUESDAY</span>
            <span class="text-stone-300">Review</span>
          </div>
        </div>
      </div>
      <span class="text-[8px] font-mono text-stone-300 text-right">PAGE 12</span>
    </div>

    <!-- 3. MAIN PREMIUM PLANNER HARDCOVER (The Visual Hero) -->
    <div class="relative w-[285px] sm:w-[325px] h-[385px] sm:h-[430px] bg-gradient-to-b from-[#FCFBF9] via-[#FAF8F5] to-[#F3EEE6] rounded-xl border border-stone-300/90 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.12),0_4px_12px_rgba(0,0,0,0.04)] z-20 flex flex-col justify-between p-8 sm:p-10 overflow-hidden select-none ring-1 ring-inset ring-black/5">

      <!-- Metallic Champagne/Silver Paper Clip (Top Left) -->
      <div class="absolute -top-2.5 left-7 w-3.5 h-7 border border-purple-300/80 bg-purple-50/70 rounded-xs shadow-2xs z-30 pointer-events-none"></div>

      <!-- Embossed Inner Border Accent -->
      <div class="absolute inset-3.5 rounded-lg border border-purple-950/10 pointer-events-none"></div>

      <!-- Spine Depth / Thickness (Left Edge Hardcover 3D Feel) -->
      <div class="absolute left-0 top-0 bottom-0 w-[6px] bg-gradient-to-r from-stone-300/70 via-stone-200/40 to-transparent border-r border-stone-300/40"></div>

      <!-- Slender Purple Silk Bookmark Ribbon (Top Right) -->
      <div class="absolute top-0 right-8 w-2.5 h-12 bg-gradient-to-b from-[#7C3AED] to-[#5B21B6] shadow-xs z-30 pointer-events-none" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 88%, 0 100%);"></div>

      <!-- Cover Top: Brand & Collection -->
      <div class="pt-1 text-center space-y-1">
        <span class="text-[10px] font-bold tracking-[0.38em] text-stone-800 uppercase font-sans block">
          TOOLTAILS
        </span>
        <span class="text-[8.5px] font-medium tracking-[0.32em] text-[#7C3AED] uppercase font-mono block">
          Digital Planning Collection
        </span>
      </div>

      <!-- Cover Center: Editorial Typography Hierarchy -->
      <div class="my-auto text-center space-y-3.5 py-6">
        <h2 class="text-3xl sm:text-4xl font-serif italic font-normal tracking-tight text-stone-900 leading-tight">
          {displayTitle}<br/><span class="not-italic font-medium text-stone-800">System</span>
        </h2>

        <!-- Tooltails Purple Accent Line -->
        <div class="w-8 h-px bg-gradient-to-r from-transparent via-[#7C3AED] to-transparent mx-auto my-3"></div>

        <p class="text-[9px] font-serif italic tracking-wide text-stone-500" id="planner-cover-name-tag">
          {userName}
        </p>
      </div>

      <!-- Cover Bottom: Whitespace Footer -->
      <div class="border-t border-stone-200/70 pt-3 flex items-center justify-between text-[8px] font-mono tracking-widest text-stone-400 uppercase">
        <span>SYSTEM NO. 01</span>
        <span class="text-[#7C3AED] font-sans font-semibold">HYPERLINKED</span>
      </div>

    </div>

  </div>

</div>
