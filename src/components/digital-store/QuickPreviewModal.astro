---
import { products } from "../../data/products";
---

<!-- QUICK PREVIEW MODAL DRAWER -->
<div id="quick-preview-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300" role="dialog" aria-modal="true" aria-labelledby="preview-modal-title">
  
  <!-- Backdrop Blur overlay -->
  <div id="quick-preview-backdrop" class="absolute inset-0 bg-stone-900/60 backdrop-blur-xs transition-opacity duration-300"></div>

  <!-- Modal Container -->
  <div class="relative w-full max-w-3xl bg-[#FAF7F2] rounded-3xl border border-[#EAE3D8] shadow-2xl overflow-hidden flex flex-col md:flex-row max-h-[90vh] z-10 transform scale-95 transition-all duration-300" id="quick-preview-card">
    
    <!-- Close Button -->
    <button id="quick-preview-close" class="absolute top-3 right-3 z-20 w-8 h-8 rounded-full bg-white/80 border border-stone-200 flex items-center justify-center text-stone-600 hover:text-stone-900 hover:bg-white transition-all shadow-xs" aria-label="Close preview">
      ✕
    </button>

    <!-- Left Visual Stage: Multi-Page Interactive Flip -->
    <div class="w-full md:w-1/2 bg-gradient-to-br from-[#FAF5EE] via-[#FFFDF9] to-[#F5EFE6] p-6 flex flex-col items-center justify-between border-b md:border-b-0 md:border-r border-[#EAE3D8] relative">
      
      <!-- Top Stage Badge -->
      <div class="w-full flex items-center justify-between text-[10px] font-bold text-amber-800 uppercase tracking-widest mb-4">
        <span id="preview-modal-category">Study & Exams</span>
        <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">✓ AI Compiled</span>
      </div>

      <!-- Center Notebook Cover Mockup -->
      <div class="relative w-full aspect-[4/5] bg-[#FFFDF9] rounded-2xl border-2 border-[#D4AF37]/40 shadow-xl p-5 flex flex-col justify-between overflow-hidden my-auto" id="preview-cover-stage">
        
        <!-- Book Header -->
        <div class="flex items-center justify-between text-[8px] font-bold uppercase tracking-widest text-amber-800 border-b border-[#E8DFD0] pb-2">
          <span id="preview-modal-badge">Personalized System</span>
          <span>Tooltails AI</span>
        </div>

        <!-- Cover Main Title -->
        <div class="text-center space-y-2 my-auto">
          <span id="preview-modal-icon" class="text-3xl block">📖</span>
          <h3 id="preview-modal-title" class="text-xl font-bold font-serif text-stone-900 leading-tight">Study Planner Pro</h3>
          <p id="preview-modal-name" class="text-xs font-serif italic text-blue-600 font-semibold">Alex Johnson</p>
        </div>

        <!-- Cover Footer -->
        <div class="flex items-center justify-between pt-2 border-t border-[#E8DFD0] text-[8px] font-semibold text-stone-500">
          <span>Print-Ready PDF + DOCX</span>
          <span class="text-emerald-700 font-bold">GoodNotes Ready</span>
        </div>

        <!-- Satin Bookmark Strap -->
        <div class="w-3 h-10 bg-blue-600 rounded-b shadow-sm absolute top-0 right-6 z-10"></div>
      </div>

      <!-- Bottom Page Spread Switcher Tabs -->
      <div class="flex items-center justify-center gap-2 mt-4 pt-2">
        <button class="preview-page-tab active text-[10px] font-bold px-2.5 py-1 rounded-full bg-stone-900 text-white shadow-2xs">Cover</button>
        <button class="preview-page-tab text-[10px] font-bold px-2.5 py-1 rounded-full bg-white text-stone-700 border border-stone-200">Weekly Spread</button>
        <button class="preview-page-tab text-[10px] font-bold px-2.5 py-1 rounded-full bg-white text-stone-700 border border-stone-200">Goal Blueprint</button>
      </div>

    </div>

    <!-- Right Column: Specs, Features & Quick Personalization -->
    <div class="w-full md:w-1/2 p-6 flex flex-col justify-between space-y-4 overflow-y-auto">
      
      <div class="space-y-3">
        <!-- Title & Price -->
        <div>
          <div class="flex items-center justify-between">
            <span id="preview-modal-rating" class="text-xs font-bold text-amber-600">★ 4.9 (128 reviews)</span>
            <span id="preview-modal-price" class="text-xl font-bold font-heading text-stone-900">$19.99</span>
          </div>
          <h2 id="preview-modal-heading" class="text-2xl font-bold font-serif text-stone-900 leading-tight">Study Planner Pro</h2>
          <p id="preview-modal-tagline" class="text-xs text-stone-600 font-medium leading-relaxed mt-1">
            Complete academic command center with automated subject planners and exam countdowns.
          </p>
        </div>

        <!-- Format Badges -->
        <div class="p-3 bg-white rounded-xl border border-[#EAE3D8] space-y-2">
          <span class="text-[9.5px] font-bold text-stone-400 uppercase tracking-wider block">Included File Formats:</span>
          <div class="flex flex-wrap gap-1.5 text-[10px] font-semibold text-stone-700">
            <span class="px-2 py-0.5 rounded bg-[#FAF5EE] border border-[#EBE2D5] flex items-center gap-1">📄 Vector PDF (A4 & US Letter)</span>
            <span class="px-2 py-0.5 rounded bg-[#FAF5EE] border border-[#EBE2D5] flex items-center gap-1">📝 Editable Word (.docx)</span>
            <span class="px-2 py-0.5 rounded bg-[#FAF5EE] border border-[#EBE2D5] flex items-center gap-1">📱 GoodNotes & iPad App</span>
          </div>
        </div>

        <!-- Quick Customization Sample Field -->
        <div class="space-y-1.5 pt-1">
          <label for="modal-live-name" class="block text-xs font-bold text-stone-800">
            Test Live Cover Name:
          </label>
          <input
            type="text"
            id="modal-live-name"
            value="Alex Johnson"
            placeholder="Enter your name..."
            class="w-full px-3 py-2 text-xs bg-white border border-[#EAE3D8] rounded-xl text-stone-900 font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <!-- Key Included Worksheets -->
        <div class="space-y-1 text-xs font-medium text-stone-700">
          <span class="font-bold text-stone-900 text-[11px] block">Included Worksheets:</span>
          <div class="space-y-1 text-[11px] text-stone-600">
            <div class="flex items-center gap-1.5"><span class="text-emerald-600 font-bold">✓</span> Personalized Cover & Goal Page</div>
            <div class="flex items-center gap-1.5"><span class="text-emerald-600 font-bold">✓</span> Weekly Focus & Task Spreads</div>
            <div class="flex items-center gap-1.5"><span class="text-emerald-600 font-bold">✓</span> 30-Day Revision Tracker & Countdown</div>
            <div class="flex items-center gap-1.5"><span class="text-emerald-600 font-bold">✓</span> Habit Grids & Notes Pages</div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 border-t border-[#EAE3D8] space-y-2">
        <a id="preview-modal-cta" href="/digital-store/study-planner" class="w-full py-3 px-4 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs text-center shadow-md hover:shadow-lg transition-all block">
          Customize & Download Now →
        </a>
        <p class="text-[10px] text-center text-stone-400 font-medium">30 days free regenerations included with every download</p>
      </div>

    </div>

  </div>
</div>

<script>
// Modal Toggle Script
const modal = document.getElementById('quick-preview-modal');
const backdrop = document.getElementById('quick-preview-backdrop');
const closeBtn = document.getElementById('quick-preview-close');
const liveNameInput = document.getElementById('modal-live-name') as HTMLInputElement | null;
const previewName = document.getElementById('preview-modal-name');

function closeModal() {
  if (!modal) return;
  modal.classList.add('opacity-0', 'pointer-events-none');
  modal.querySelector('#quick-preview-card')?.classList.add('scale-95');
}

if (closeBtn) closeBtn.addEventListener('click', closeModal);
if (backdrop) backdrop.addEventListener('click', closeModal);

if (liveNameInput && previewName) {
  liveNameInput.addEventListener('input', () => {
    previewName.textContent = liveNameInput.value.trim() || 'Alex Johnson';
  });
}

// Global window trigger to open preview modal for any product
(window as any).openQuickPreview = function(prodId: string) {
  if (!modal) return;
  
  // Find product card data
  const card = document.querySelector(`[data-id="${prodId}"]`);
  const title = card?.querySelector('h3, h4')?.textContent?.trim() || 'Planner System';
  const price = card?.querySelector('.font-heading')?.textContent?.trim() || '$19.99';
  const cat = card?.querySelector('[data-category-label]')?.textContent?.trim() || 'Productivity System';
  const icon = card?.querySelector('.filter')?.textContent?.trim() || '📖';

  const modalTitle = document.getElementById('preview-modal-title');
  const modalHeading = document.getElementById('preview-modal-heading');
  const modalPrice = document.getElementById('preview-modal-price');
  const modalCat = document.getElementById('preview-modal-category');
  const modalIcon = document.getElementById('preview-modal-icon');
  const modalCta = document.getElementById('preview-modal-cta') as HTMLAnchorElement | null;

  if (modalTitle) modalTitle.textContent = title;
  if (modalHeading) modalHeading.textContent = title;
  if (modalPrice) modalPrice.textContent = price;
  if (modalCat) modalCat.textContent = cat;
  if (modalIcon) modalIcon.textContent = icon;
  if (modalCta) modalCta.href = `/digital-store/${prodId}`;

  modal.classList.remove('opacity-0', 'pointer-events-none');
  modal.querySelector('#quick-preview-card')?.classList.remove('scale-95');
};
</script>
