---
const currentYear = new Date().getFullYear();
const isFocusPath = Astro.url.pathname.startsWith('/focus');
const isPomodoroPath = Astro.url.pathname.startsWith('/pomodoro-timer');
const isWordCounterPath = Astro.url.pathname.startsWith('/word-counter');
const isStudySchedulePath = Astro.url.pathname.startsWith('/study-schedule');
const isResumeCheckerPath = Astro.url.pathname.startsWith('/resume-checker');
---

<footer class="bg-canvas border-t border-hairline py-12 md:py-24">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href={isFocusPath ? "/focus" : isPomodoroPath ? "/pomodoro-timer" : isWordCounterPath ? "/word-counter" : isStudySchedulePath ? "/study-schedule" : isResumeCheckerPath ? "/resume-checker" : "/"} class="text-xl font-bold tracking-tighter text-ink mb-4 inline-block">
          Tooltails<span class="text-primary">{isFocusPath ? " Focus" : isPomodoroPath ? " Pomodoro" : isWordCounterPath ? " Word Counter" : isStudySchedulePath ? " Study Schedule" : isResumeCheckerPath ? " Resume Checker" : ".com"}</span>
        </a>
        <p class="text-sm text-body leading-relaxed max-w-xs">
          {isFocusPath 
            ? "Tooltails Focus is an outcome-based productivity timer designed to help you plan, execute, and ship your goals."
            : isPomodoroPath
            ? "Tooltails Pomodoro is a free focus timer with task tracking, daily streaks, and productivity analytics."
            : isWordCounterPath
            ? "Tooltails Word Counter is a free text analysis tool with word count, readability scoring, keyword density, and speech timing, all processed locally in your browser."
            : isStudySchedulePath
            ? "Tooltails Study Schedule is an intelligent exam coach that shows your readiness score, predicts when you'll finish, and adapts as you study. Free, no login."
            : isResumeCheckerPath
            ? "Tooltails Resume Checker is a privacy-first ATS optimization editor designed to help you align your experience, inject missing skills, and ship a high-scoring, layout-perfect resume."
            : "Tooltails is a collection of free online calculators and utility tools designed to simplify everyday tasks."}
        </p>
      </div>
      
      <nav aria-label="Tools">
        <h4 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">
          {isFocusPath ? "Product" : isPomodoroPath ? "Product" : isWordCounterPath ? "Product" : isStudySchedulePath ? "Product" : isResumeCheckerPath ? "Product" : "Popular Tools"}
        </h4>
        <ul class="space-y-2">
          {isFocusPath ? (
            <>
              <li><a href="/focus" class="text-sm text-body hover:text-ink transition-colors">Focus Timer</a></li>
              <li><a href="/" class="text-sm text-body hover:text-ink transition-colors">Tooltails Home</a></li>
              <li><a href="/age-calculator" class="text-sm text-body hover:text-ink transition-colors">Age Calculator</a></li>
              <li><a href="/pomodoro-timer" class="text-sm text-body hover:text-ink transition-colors">Pomodoro Timer</a></li>
            </>
          ) : isPomodoroPath ? (
            <>
              <li><a href="/pomodoro-timer" class="text-sm text-body hover:text-ink transition-colors">Pomodoro Timer</a></li>
              <li><a href="/" class="text-sm text-body hover:text-ink transition-colors">Tooltails Home</a></li>
              <li><a href="/focus" class="text-sm text-body hover:text-ink transition-colors">Focus Goals Timer</a></li>
              <li><a href="/age-calculator" class="text-sm text-body hover:text-ink transition-colors">Age Calculator</a></li>
            </>
          ) : isWordCounterPath ? (
            <>
              <li><a href="/word-counter" class="text-sm text-body hover:text-ink transition-colors">Word Counter</a></li>
              <li><a href="/" class="text-sm text-body hover:text-ink transition-colors">Tooltails Home</a></li>
              <li><a href="/focus" class="text-sm text-body hover:text-ink transition-colors">Focus Timer</a></li>
              <li><a href="/age-calculator" class="text-sm text-body hover:text-ink transition-colors">Age Calculator</a></li>
            </>
          ) : isStudySchedulePath ? (
            <>
              <li><a href="/study-schedule" class="text-sm text-body hover:text-ink transition-colors">Study Schedule</a></li>
              <li><a href="/" class="text-sm text-body hover:text-ink transition-colors">Tooltails Home</a></li>
              <li><a href="/focus" class="text-sm text-body hover:text-ink transition-colors">Focus Timer</a></li>
              <li><a href="/pomodoro-timer" class="text-sm text-body hover:text-ink transition-colors">Pomodoro Timer</a></li>
            </>
          ) : isResumeCheckerPath ? (
            <>
              <li><a href="/resume-checker" class="text-sm text-body hover:text-ink transition-colors">Resume Checker</a></li>
              <li><a href="/" class="text-sm text-body hover:text-ink transition-colors">Tooltails Home</a></li>
              <li><a href="/focus" class="text-sm text-body hover:text-ink transition-colors">Focus Goals Timer</a></li>
              <li><a href="/pomodoro-timer" class="text-sm text-body hover:text-ink transition-colors">Pomodoro Timer</a></li>
            </>
          ) : (
            <>
              <li><a href="/age-calculator" class="text-sm text-body hover:text-ink transition-colors">Age Calculator</a></li>
              <li><a href="/age-difference" class="text-sm text-body hover:text-ink transition-colors">Age Difference</a></li>
              <li><a href="/birthday-countdown" class="text-sm text-body hover:text-ink transition-colors">Birthday Countdown</a></li>
              <li><a href="/duration" class="text-sm text-body hover:text-ink transition-colors">Date Duration</a></li>
              <li><a href="/future-age" class="text-sm text-body hover:text-ink transition-colors">Future Age</a></li>
              <li><a href="/pomodoro-timer" class="text-sm text-body hover:text-ink transition-colors">Pomodoro Timer</a></li>
              <li><a href="/focus" class="text-sm text-body hover:text-ink transition-colors">Focus Goals Timer</a></li>
              <li><a href="/word-counter" class="text-sm text-body hover:text-ink transition-colors">Word Counter</a></li>
              <li><a href="/study-schedule" class="text-sm text-body hover:text-ink transition-colors">Study Schedule Generator</a></li>
            </>
          )}
        </ul>
      </nav>

      <nav aria-label="Resources">
        <h4 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Resources</h4>
        <ul class="space-y-2">
          {isFocusPath ? (
            <>
              <li><a href="/focus/blog" class="text-sm text-body hover:text-ink transition-colors">Focus Blog</a></li>
              <li><a href="/focus/contact" class="text-sm text-body hover:text-ink transition-colors">Contact Support</a></li>
              <li><a href="/about" class="text-sm text-body hover:text-ink transition-colors">About Tooltails</a></li>
            </>
          ) : isPomodoroPath ? (
            <>
              <li><a href="/pomodoro-timer/blog" class="text-sm text-body hover:text-ink transition-colors">Pomodoro Blog</a></li>
              <li><a href="/pomodoro-timer/contact" class="text-sm text-body hover:text-ink transition-colors">Contact Support</a></li>
              <li><a href="/about" class="text-sm text-body hover:text-ink transition-colors">About Tooltails</a></li>
            </>
          ) : isWordCounterPath ? (
            <>
              <li><a href="/blog" class="text-sm text-body hover:text-ink transition-colors">Blog</a></li>
              <li><a href="/faqs" class="text-sm text-body hover:text-ink transition-colors">FAQs</a></li>
              <li><a href="/about" class="text-sm text-body hover:text-ink transition-colors">About Tooltails</a></li>
              <li><a href="/contact" class="text-sm text-body hover:text-ink transition-colors">Contact</a></li>
            </>
          ) : isStudySchedulePath ? (
            <>
              <li><a href="/study-schedule/blog" class="text-sm text-body hover:text-ink transition-colors">Study Schedule Blog</a></li>
              <li><a href="/about" class="text-sm text-body hover:text-ink transition-colors">About Tooltails</a></li>
              <li><a href="/faqs" class="text-sm text-body hover:text-ink transition-colors">FAQs</a></li>
              <li><a href="/contact" class="text-sm text-body hover:text-ink transition-colors">Contact</a></li>
            </>
          ) : isResumeCheckerPath ? (
            <>
              <li><a href="/resume-checker/blog" class="text-sm text-body hover:text-ink transition-colors">Resume Blog</a></li>
              <li><a href="/faqs" class="text-sm text-body hover:text-ink transition-colors">FAQs</a></li>
              <li><a href="/about" class="text-sm text-body hover:text-ink transition-colors">About Tooltails</a></li>
              <li><a href="/contact" class="text-sm text-body hover:text-ink transition-colors">Contact Support</a></li>
            </>
          ) : (
            <>
              <li><a href="/blog" class="text-sm text-body hover:text-ink transition-colors">Blog</a></li>
              <li><a href="/faqs" class="text-sm text-body hover:text-ink transition-colors">FAQs</a></li>
              <li><a href="/about" class="text-sm text-body hover:text-ink transition-colors">About Us</a></li>
              <li><a href="/contact" class="text-sm text-body hover:text-ink transition-colors">Contact</a></li>
            </>
          )}
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h4 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Legal</h4>
        <ul class="space-y-2">
          {isFocusPath ? (
            <>
              <li><a href="/focus/privacy" class="text-sm text-body hover:text-ink transition-colors">Privacy Policy</a></li>
              <li><a href="/focus/terms" class="text-sm text-body hover:text-ink transition-colors">Terms of Service</a></li>
            </>
          ) : isPomodoroPath ? (
            <>
              <li><a href="/pomodoro-timer/privacy" class="text-sm text-body hover:text-ink transition-colors">Privacy Policy</a></li>
              <li><a href="/pomodoro-timer/terms" class="text-sm text-body hover:text-ink transition-colors">Terms of Service</a></li>
            </>
          ) : isWordCounterPath ? (
            <>
              <li><a href="/privacy" class="text-sm text-body hover:text-ink transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="text-sm text-body hover:text-ink transition-colors">Terms of Service</a></li>
            </>
          ) : isStudySchedulePath ? (
            <>
              <li><a href="/privacy" class="text-sm text-body hover:text-ink transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="text-sm text-body hover:text-ink transition-colors">Terms of Service</a></li>
            </>
          ) : isResumeCheckerPath ? (
            <>
              <li><a href="/privacy" class="text-sm text-body hover:text-ink transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="text-sm text-body hover:text-ink transition-colors">Terms of Service</a></li>
            </>
          ) : (
            <>
              <li><a href="/privacy" class="text-sm text-body hover:text-ink transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="text-sm text-body hover:text-ink transition-colors">Terms of Service</a></li>
            </>
          )}
        </ul>
      </nav>
    </div>

    <div class="mt-12 pt-8 border-t border-hairline flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex flex-col md:flex-row items-center gap-4">
        <p class="text-xs text-mute">
          &copy; {currentYear} Tooltails.com. All rights reserved.
        </p>
        <span class="hidden md:inline text-hairline-strong text-[10px]">•</span>
        <p class="text-[10px] font-medium text-mute uppercase tracking-widest">
          {isFocusPath ? "Outcome-oriented focus timer • Privacy friendly • No signup required" : isPomodoroPath ? "Free Pomodoro timer • Privacy friendly • No signup required" : isWordCounterPath ? "Free word counter & text analysis • Privacy friendly • No signup required" : isStudySchedulePath ? "Intelligent exam coach & study planner • Privacy friendly • No signup required" : isResumeCheckerPath ? "Privacy-first ATS resume optimizer • Local analysis • No signup required" : "Free online age calculator • Privacy friendly • No signup required"}
        </p>
      </div>
      <div class="flex gap-6">
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="text-mute hover:text-ink transition-colors"><span class="sr-only">Twitter</span><svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg></a>
      </div>
    </div>
  </div>
</footer>
