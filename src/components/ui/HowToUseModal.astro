---
export interface Step {
  title: string;
  description: string;
}

export interface Props {
  toolName: string;
  steps: Step[];
  tip?: string;
  className?: string;
  buttonClass?: string;
}

const { toolName, steps, tip, className = "", buttonClass = "" } = Astro.props;
const modalId = `how-to-use-${toolName.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const titleId = `${modalId}-title`;
---

<div class:list={["inline-block how-to-use-wrapper", className]}>
  <!-- Trigger Button -->
  <button
    type="button"
    class:list={[
      "how-to-use-trigger inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-ink transition-all shadow-sm cursor-pointer hover:border-link/30 hover:text-link active:scale-95 select-none",
      buttonClass
    ]}
    data-target={modalId}
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls={modalId}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-link shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
    <span>How to Use</span>
  </button>

  <!-- Modal Overlay / Dialog -->
  <div
    id={modalId}
    class="how-to-use-modal fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/50 backdrop-blur-sm transition-opacity duration-200 opacity-0 pointer-events-none hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby={titleId}
  >
    <div
      class="how-to-use-dialog relative w-full max-w-lg bg-canvas border border-hairline rounded-3xl shadow-2xl p-6 sm:p-8 max-h-[85vh] overflow-y-auto transform transition-all duration-200 scale-95 opacity-0 text-left"
    >
      <!-- Modal Header -->
      <div class="flex items-center justify-between gap-4 pb-4 border-b border-hairline">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-link/10 text-link flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
          </div>
          <div>
            <h2 id={titleId} class="text-base sm:text-lg font-bold text-ink tracking-tight">
              How to Use {toolName}
            </h2>
            <p class="text-xs text-mute font-medium">Quick step-by-step guide</p>
          </div>
        </div>
        <button
          type="button"
          class="modal-close-btn w-8 h-8 rounded-full border border-hairline flex items-center justify-center text-mute hover:text-ink hover:bg-canvas-soft transition-colors cursor-pointer shrink-0"
          aria-label="Close instructions"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Step-by-Step Instructions -->
      <ol class="space-y-4 my-6 list-none p-0">
        {steps.map((step, index) => (
          <li class="flex items-start gap-3.5">
            <span class="w-6 h-6 rounded-full bg-link/10 text-link text-xs font-bold flex items-center justify-center shrink-0 mt-0.5 border border-link/20">
              {index + 1}
            </span>
            <div class="flex-1">
              <h3 class="text-sm font-bold text-ink mb-0.5 tracking-tight">
                {step.title}
              </h3>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                {step.description}
              </p>
            </div>
          </li>
        ))}
      </ol>

      <!-- Pro-Tip Box (Optional) -->
      {tip && (
        <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline flex items-start gap-3 mb-6">
          <div class="w-5 h-5 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2v1"></path>
              <path d="M12 21v1"></path>
              <path d="M4.93 4.93l.7.7"></path>
              <path d="M18.36 18.36l.7.7"></path>
              <path d="M2 12h1"></path>
              <path d="M21 12h1"></path>
              <path d="M4.93 19.07l.7-.7"></path>
              <path d="M18.36 5.64l.7-.7"></path>
              <circle cx="12" cy="12" r="4"></circle>
            </svg>
          </div>
          <div class="flex-1">
            <span class="text-xs font-bold text-ink uppercase tracking-wider block mb-0.5">Pro-Tip</span>
            <p class="text-xs text-body leading-relaxed">{tip}</p>
          </div>
        </div>
      )}

      <!-- Modal Footer Action -->
      <div class="flex items-center justify-end pt-4 border-t border-hairline">
        <button
          type="button"
          class="modal-close-btn w-full sm:w-auto px-6 py-2 text-xs font-bold text-white bg-link rounded-full hover:opacity-90 active:scale-95 transition-all cursor-pointer shadow-sm text-center"
        >
          Got it
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupHowToUseModals() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.how-to-use-trigger');
    
    triggers.forEach(trigger => {
      if (trigger.dataset.initialized) return;
      trigger.dataset.initialized = 'true';

      const targetId = trigger.getAttribute('data-target');
      if (!targetId) return;
      
      const modal = document.getElementById(targetId);
      if (!modal) return;

      const dialog = modal.querySelector<HTMLElement>('.how-to-use-dialog');
      const closeButtons = modal.querySelectorAll<HTMLButtonElement>('.modal-close-btn');

      const openModal = () => {
        modal.classList.remove('hidden', 'pointer-events-none');
        trigger.setAttribute('aria-expanded', 'true');
        // Force reflow for CSS transition
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        if (dialog) {
          dialog.classList.remove('scale-95', 'opacity-0');
          dialog.classList.add('scale-100', 'opacity-100');
        }
        document.body.style.overflow = 'hidden';

        // Focus first close button or dialog
        const firstFocusable = modal.querySelector<HTMLElement>('button, [tabindex="0"]');
        if (firstFocusable) firstFocusable.focus();
      };

      const closeModal = () => {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        if (dialog) {
          dialog.classList.remove('scale-100', 'opacity-100');
          dialog.classList.add('scale-95', 'opacity-0');
        }
        trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';

        setTimeout(() => {
          modal.classList.add('hidden', 'pointer-events-none');
          trigger.focus();
        }, 200);
      };

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });

      closeButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          closeModal();
        });
      });

      // Backdrop click
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Keyboard navigation: Escape key & Tab trapping
      modal.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeModal();
          return;
        }

        if (e.key === 'Tab') {
          const focusables = modal.querySelectorAll<HTMLElement>(
            'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
          );
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];

          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    });
  }

  // Initialize on load and on Astro page swaps if view transitions are used
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHowToUseModals);
  } else {
    setupHowToUseModals();
  }
  document.addEventListener('astro:page-load', setupHowToUseModals);
</script>
