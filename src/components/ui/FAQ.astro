---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  class?: string;
  renderSchema?: boolean;
}

const { items, class: className, renderSchema = true } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<div class:list={['space-y-5', className]}>
  <div class="flex items-center gap-3">
    <h2 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Frequently Asked Questions</h2>
    <div class="h-px w-full bg-hairline"></div>
  </div>
  <div class="grid gap-4">
    {items.map((item) => (
      <div class="border-b border-hairline pb-4">
        <h3 class="text-sm font-semibold text-ink tracking-tight mb-1.5">{item.question}</h3>
        <p class="text-sm text-body leading-relaxed">{item.answer}</p>
      </div>
    ))}
  </div>
</div>

{renderSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
