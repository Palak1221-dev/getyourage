---
import Layout from "../../layouts/Layout.astro";

import FAQ from "../../components/ui/FAQ.astro";

// FAQ Items for SEO
const faqItems = [
  {
    question: "What's the difference between this and a regular Pomodoro timer?",
    answer: "A Pomodoro timer just counts down 25-minute blocks. Tooltails Focus flips the question from 'how long did you sit there?' to 'did you actually get it done?'. You write down a real goal before you start, break it into smaller checkpoints, then log whether you finished, partly finished, or hit a wall. It's less about compliance and more about shipping."
  },
  {
    question: "What happens when I mark a session as Partial or Failed?",
    answer: "Instead of guilt, you get a recovery plan. The engine looks at what went wrong — distraction, fatigue, or a goal that was too big — and suggests a practical next step. Maybe shorter blocks, a screen break, or breaking your goal down further. The idea is to learn, not to punish."
  },
  {
    question: "Is my data safe? Do I need an account?",
    answer: "No accounts, no servers, no cloud. Everything — your sessions, streaks, checkpoints, journal entries — lives in your browser's LocalStorage. You can export a backup anytime, but nothing ever leaves your machine unless you choose to save the file."
  },
  {
    question: "How do the ambient sounds work without downloading anything?",
    answer: "Instead of loading audio files, your browser generates the sounds on the fly using the Web Audio API. Brown noise, white noise, and rain are all synthesized in real time. That means zero downloads, zero buffering, and it all works offline."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Tooltails Focus",
  "operatingSystem": "Web",
  "applicationCategory": "ProductivityApplication",
  "description": "An offline-first focus workspace with goal planning, checkpoint tracking, completion analytics, ambient sounds, and streak heatmaps — all in your browser.",
  "url": Astro.url.origin + "/focus",
  "featureList": [
    "Goal-Oriented Focus Timer (Intention over raw seconds)",
    "Checkpoint Decomposer (Milestone checklist)",
    "Cognitive Recovery Coach (Actionable diagnostics)",
    "Synthesized Ambient Sound Engine (Web Audio API)",
    "Offline-first LocalStorage Persistence",
    "Personal Growth & Weekly Reflection Diagnostics"
  ],
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "image": Astro.url.origin + "/og-image.png",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout 
  title="Focus Timer with Goal Planning — Tooltails Focus" 
  description="An offline-first focus workspace: set a goal, break it into checkpoints, and track your completion rate. Includes ambient sounds, streak tracking, and heatmap analytics — all in your browser."
  image="/og-focus.png"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />
  <!-- Main View Container -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 py-1 md:py-4 relative">
    
    <span id="global-streak-value" class="hidden">0</span>
    <span id="global-success-rate" class="hidden">0%</span>

    <!-- Minimal header -->
        <div class="flex items-center justify-between mb-3 md:mb-5 select-none">
        <h1 class="text-xl md:text-3xl font-extrabold tracking-tight text-ink">
          Focus
        </h1>
        <div class="flex items-center gap-2">
          <div role="tablist" class="flex items-center gap-1.5 bg-canvas-soft-2/80 rounded-full p-0.5">
        <button id="tab-btn-workspace" role="tab" aria-selected="true" aria-controls="tab-workspace" class="tab-btn px-4 py-2 sm:py-1.5 min-h-[44px] text-sm font-semibold rounded-full bg-canvas text-ink shadow-sm focus-visible:outline-none transition-all duration-150 cursor-pointer active:scale-[0.96]" onclick="switchTab('workspace')" aria-label="Open workspace tab">
          Timer
        </button>
        <button id="tab-btn-analytics" role="tab" aria-selected="false" aria-controls="tab-analytics" class="tab-btn px-4 py-2 sm:py-1.5 min-h-[44px] text-sm font-semibold rounded-full text-body hover:text-ink transition-all duration-150 cursor-pointer active:scale-[0.96]" onclick="switchTab('analytics')" aria-label="Open progress analytics tab">
          Progress
        </button>
        <button id="tab-btn-premium" role="tab" aria-selected="false" aria-controls="tab-premium" class="tab-btn px-4 py-2 sm:py-1.5 min-h-[44px] text-sm font-semibold rounded-full text-body hover:text-ink transition-all duration-150 cursor-pointer active:scale-[0.96]" onclick="switchTab('premium')" aria-label="Open growth and coaching tab">
          Journal
        </button>
      </div>
      </div>
    </div>

    <!-- APP CONTENT BODY -->
    
    <!-- TAB 1: WORKSPACE -->
    <div id="tab-workspace" role="tabpanel" aria-labelledby="tab-btn-workspace" class="transition-all duration-500">
      <!-- Hidden onboarding tracker for LocalStorage warning insertion -->
      <div id="onboarding-tracker" class="hidden" aria-hidden="true"></div>

      <!-- FIRST-RUN EXPERIENCE -->
      <div id="first-run-experience" class="hidden max-w-[1400px] mx-auto bg-canvas rounded-2xl border border-hairline/60 shadow-sm mb-6 p-6 lg:p-8 space-y-6">
        <div class="text-center space-y-2">
          <span class="text-xs font-semibold text-link uppercase tracking-wider">Welcome to Tooltails Focus</span>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">Set a goal. Focus. Make progress.</h2>
          <p class="text-sm text-body/70 max-w-lg mx-auto">Pick an example or choose a template. You can always change it.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <button type="button" class="first-run-example text-left p-4 rounded-2xl border border-hairline/60 bg-canvas-soft/30 hover:border-link/30 hover:bg-link/[0.02] motion-safe:hover:-translate-y-0.5 motion-safe:transition-all motion-safe:duration-200 cursor-pointer group" data-goal="Draft a blog outline" data-activity="Writing">
            <span class="text-lg mb-1 block">âœï¸</span>
            <span class="text-sm font-semibold text-ink block">Draft a blog outline</span>
            <span class="text-xs text-mute/60 mt-1 block">Writing · ~30 min</span>
          </button>
          <button type="button" class="first-run-example text-left p-4 rounded-2xl border border-hairline/60 bg-canvas-soft/30 hover:border-link/30 hover:bg-link/[0.02] motion-safe:hover:-translate-y-0.5 motion-safe:transition-all motion-safe:duration-200 cursor-pointer group" data-goal="Finish chapter 3 notes" data-activity="Study">
            <span class="text-lg mb-1 block">ðŸ“š</span>
            <span class="text-sm font-semibold text-ink block">Finish chapter 3 notes</span>
            <span class="text-xs text-mute/60 mt-1 block">Study · ~40 min</span>
          </button>
          <button type="button" class="first-run-example text-left p-4 rounded-2xl border border-hairline/60 bg-canvas-soft/30 hover:border-link/30 hover:bg-link/[0.02] motion-safe:hover:-translate-y-0.5 motion-safe:transition-all motion-safe:duration-200 cursor-pointer group" data-goal="Review meeting notes & plan tomorrow priorities" data-activity="Reading">
            <span class="text-lg mb-1 block">ðŸ“–</span>
            <span class="text-sm font-semibold text-ink block">Review meeting notes & plan tomorrow priorities</span>
            <span class="text-xs text-mute/60 mt-1 block">Planning · ~25 min</span>
          </button>
        </div>

        <div class="flex items-center gap-3">
          <span class="h-px flex-1 bg-hairline/60"></span>
          <span class="text-xs text-mute/40 font-medium">or choose a template</span>
          <span class="h-px flex-1 bg-hairline/60"></span>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-2.5">
          <button type="button" class="first-run-template px-5 h-11 rounded-2xl border border-hairline/60 text-sm font-semibold text-ink bg-canvas hover:bg-canvas-soft hover:border-link/30 motion-safe:transition-all motion-safe:duration-200 cursor-pointer" data-template="Study"><span class="text-base">ðŸ“š</span> Study</button>
          <button type="button" class="first-run-template px-5 h-11 rounded-2xl border border-hairline/60 text-sm font-semibold text-ink bg-canvas hover:bg-canvas-soft hover:border-link/30 motion-safe:transition-all motion-safe:duration-200 cursor-pointer" data-template="Writing"><span class="text-base">âœï¸</span> Writing</button>
          <button type="button" class="first-run-template px-5 h-11 rounded-2xl border border-hairline/60 text-sm font-semibold text-ink bg-canvas hover:bg-canvas-soft hover:border-link/30 motion-safe:transition-all motion-safe:duration-200 cursor-pointer" data-template="Reading"><span class="text-base">ðŸ“–</span> Reading</button>
          <button type="button" class="first-run-template px-5 h-11 rounded-2xl border border-hairline/60 text-sm font-semibold text-ink bg-canvas hover:bg-canvas-soft hover:border-link/30 motion-safe:transition-all motion-safe:duration-200 cursor-pointer" data-template="Coding"><span class="text-base">ðŸ’»</span> Coding</button>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2">
          <div class="text-center space-y-1.5">
            <div class="w-8 h-8 rounded-full bg-link/10 flex items-center justify-center mx-auto"><span class="text-sm font-bold text-link">1</span></div>
            <span class="text-xs font-semibold text-ink block">Set a goal</span>
            <span class="text-[11px] text-mute/60 leading-tight block">Write what you want to accomplish</span>
          </div>
          <div class="text-center space-y-1.5">
            <div class="w-8 h-8 rounded-full bg-link/10 flex items-center justify-center mx-auto"><span class="text-sm font-bold text-link">2</span></div>
            <span class="text-xs font-semibold text-ink block">Add checkpoints</span>
            <span class="text-[11px] text-mute/60 leading-tight block">Break it into small steps</span>
          </div>
          <div class="text-center space-y-1.5">
            <div class="w-8 h-8 rounded-full bg-link/10 flex items-center justify-center mx-auto"><span class="text-sm font-bold text-link">3</span></div>
            <span class="text-xs font-semibold text-ink block">Choose your time</span>
            <span class="text-[11px] text-mute/60 leading-tight block">Pick a duration that fits</span>
          </div>
          <div class="text-center space-y-1.5">
            <div class="w-8 h-8 rounded-full bg-link/10 flex items-center justify-center mx-auto"><span class="text-sm font-bold text-link">4</span></div>
            <span class="text-xs font-semibold text-ink block">Start & reflect</span>
            <span class="text-[11px] text-mute/60 leading-tight block">Hit start, then log how it went</span>
          </div>
        </div>

        <div class="text-center">
          <button type="button" id="first-run-skip" class="text-xs text-mute/50 hover:text-mute/80 motion-safe:transition-colors motion-safe:duration-200 cursor-pointer underline underline-offset-2">Skip — I know what I'm doing</button>
        </div>
      </div>

      <!-- FOCUS WORKSPACE — premium two-column grid -->
      <div id="focus-workspace-container" class="settings-card max-w-[1400px] mx-auto bg-canvas rounded-2xl border border-hairline/60 shadow-sm transition-all duration-500">
        <div class="workspace-grid gap-2 lg:gap-3 px-4 lg:px-6 pt-5 lg:pt-5 pb-3">

          <!-- GOAL (order-1 mobile, left-col desktop) -->
          <div class="grid-area-goal w-full">
            <span class="text-xs font-semibold text-mute/80 block mb-1 text-center md:text-left">Goal</span>
            <input 
              type="text" 
              id="session-goal" 
              autocomplete="off"
              spellcheck="true"
              class="w-full h-11 px-4 bg-canvas-soft/70 rounded-2xl text-base font-semibold tracking-tight text-ink placeholder:text-mute/40 focus:outline-none focus:bg-canvas-soft/90 focus:ring-2 focus:ring-link/10 transition-all duration-200 select-text text-center md:text-left"
              placeholder="What do you want to make happen?" 
              aria-label="What do you want to make happen today?"
            />
          </div>

          <!-- WHY MATTERS (order-2 mobile, left-col desktop) -->
          <div class="grid-area-why w-full">
            <span class="text-xs font-semibold text-mute/80 block mb-1 text-center md:text-left">Why it matters</span>
            <input 
              type="text" 
              id="session-goal-why" 
              autocomplete="off"
              spellcheck="true"
              class="w-full h-11 px-4 bg-canvas-soft/70 rounded-2xl text-base font-semibold tracking-tight text-ink placeholder:text-mute/40 focus:outline-none focus:bg-canvas-soft/90 focus:ring-2 focus:ring-link/10 transition-all duration-200 select-text text-center md:text-left" 
              placeholder="What makes this meaningful? (optional)" 
              aria-label="Tell yourself why this goal matters"
            />
          </div>

          <!-- CHECKPOINTS (order-3 mobile, left-col desktop) -->
          <div class="grid-area-checks w-full space-y-1">
            <span class="text-xs font-semibold text-mute/80 block">Checklist</span>
            <div class="flex gap-1.5">
              <input 
                type="text" 
                id="milestone-input" 
                autocomplete="off" 
                class="flex-grow h-11 px-4 bg-canvas-soft/70 rounded-2xl text-base font-semibold tracking-tight text-ink placeholder:text-mute/40 focus:outline-none focus:bg-canvas-soft/90 focus:ring-2 focus:ring-link/10 transition-all duration-200" 
                placeholder="Add a stepâ†’" 
                aria-label="Add a checkpoint to your plan" 
              />
              <button 
                type="button" 
                id="add-milestone-btn" 
                class="h-11 px-4 bg-link text-white hover:bg-link-hover active:scale-95 text-sm font-semibold rounded-2xl border-0 transition-all duration-200 cursor-pointer focus-visible:ring-2 focus-visible:ring-link/50 focus-visible:outline-none" 
                aria-label="Add checkpoint to checklist"
              >
                Add step
              </button>
            </div>

            <ul id="setup-milestones-list" class="space-y-0.5 max-h-[132px] overflow-y-auto scrollbar-thin">
              <li class="flex items-center gap-2 text-sm text-mute/60 py-2 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-50"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/><path d="M15 5l3 3"/></svg>
                What's your first step?
              </li>
            </ul>
          </div>

          <!-- ACTIVITY (order-4 mobile, left-col desktop) -->
          <div class="grid-area-activity w-full select-none">
            <span class="text-xs font-semibold text-mute/80 block mb-1.5 text-center md:text-left">Activity</span>
            <div class="flex items-center justify-center md:justify-start gap-2 lg:gap-3 flex-wrap">
              <button type="button" class="activity-btn px-4 lg:px-5 py-3 sm:py-2 min-h-[44px] text-sm lg:text-base rounded-2xl bg-canvas-soft/80 text-body hover:bg-canvas-soft-2 hover:text-ink active:scale-[0.97] transition-all duration-200 cursor-pointer flex items-center gap-2 border border-transparent font-medium whitespace-nowrap" data-activity="Coding" aria-pressed="false" aria-label="Select Coding">
                <span class="text-base">ðŸ’»</span> Coding
              </button>
              <button type="button" class="activity-btn px-4 lg:px-5 py-3 sm:py-2 min-h-[44px] text-sm lg:text-base rounded-2xl bg-canvas-soft/80 text-body hover:bg-canvas-soft-2 hover:text-ink active:scale-[0.97] transition-all duration-200 cursor-pointer flex items-center gap-1.5 border border-transparent font-medium whitespace-nowrap" data-activity="Study" aria-pressed="true" aria-label="Select Study">
                <span class="text-base">ðŸ“š</span> Study
              </button>
              <button type="button" class="activity-btn px-4 lg:px-5 py-3 sm:py-2 min-h-[44px] text-sm lg:text-base rounded-2xl bg-canvas-soft/80 text-body hover:bg-canvas-soft-2 hover:text-ink active:scale-[0.97] transition-all duration-200 cursor-pointer flex items-center gap-1.5 border border-transparent font-medium whitespace-nowrap" data-activity="Reading" aria-pressed="false" aria-label="Select Reading">
                <span class="text-base">ðŸ“–</span> Reading
              </button>
              <button type="button" class="activity-btn px-4 lg:px-5 py-3 sm:py-2 min-h-[44px] text-sm lg:text-base rounded-2xl bg-canvas-soft/80 text-body hover:bg-canvas-soft-2 hover:text-ink active:scale-[0.97] transition-all duration-200 cursor-pointer flex items-center gap-1.5 border border-transparent font-medium whitespace-nowrap" data-activity="Writing" aria-pressed="false" aria-label="Select Writing">
                <span class="text-base">âœï¸</span> Writing
              </button>
              <button type="button" class="activity-btn px-4 lg:px-5 py-3 sm:py-2 min-h-[44px] text-sm lg:text-base rounded-2xl bg-canvas-soft/80 text-body hover:bg-canvas-soft-2 hover:text-ink active:scale-[0.97] transition-all duration-200 cursor-pointer flex items-center gap-1.5 border border-transparent font-medium whitespace-nowrap" data-activity="Art" aria-pressed="false" aria-label="Select Art">
                <span class="text-base">ðŸŽ¨</span> Art
              </button>
              <button type="button" class="activity-btn px-4 lg:px-5 py-3 sm:py-2 min-h-[44px] text-sm lg:text-base rounded-2xl bg-canvas-soft/80 text-body hover:bg-canvas-soft-2 hover:text-ink active:scale-[0.97] transition-all duration-200 cursor-pointer flex items-center gap-1.5 border border-transparent font-medium whitespace-nowrap" data-activity="Custom" id="act-btn-custom" aria-pressed="false" aria-label="Select Custom">
                <span class="text-base">âš™ï¸</span> Custom
              </button>
            </div>

            <!-- Custom Activity Input -->
            <input type="text" id="custom-activity-input" autocomplete="off" class="hidden w-full h-11 px-4 bg-canvas-soft/70 rounded-2xl text-base text-ink text-center focus:outline-none focus:bg-canvas-soft/90 focus:ring-2 focus:ring-link/10 transition-all duration-200" placeholder="What are you working on?" aria-label="Describe what you are working on" />
            <div id="custom-activity-next-panel" class="hidden"></div>

            <!-- Checkpoints — minimal inline add, unhides below if needed -->
            <div class="hidden" id="setup-milestones-compact">
              <!-- populated via JS if milestones exist -->
            </div>
          </div>

          <!-- TIMER + TODAY STATS (order-5 mobile, right-col desktop) -->
          <div id="timer-container-card" class="grid-area-timer w-full flex flex-col items-center justify-start relative transition-all duration-500 md:sticky md:top-4 md:self-start">

            <!-- Soft background glow -->
            <div id="timer-active-glow" class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.04),transparent_70%)] pointer-events-none opacity-0 transition-opacity duration-700 ease-out"></div>
            
            <div class="relative w-full max-w-[290px] aspect-square flex items-center justify-center select-none mb-2 timer-dial-wrapper">
              <!-- Subtle dial shadow — layered for depth -->
              <div class="absolute inset-[3%] rounded-full bg-gradient-to-b from-canvas-soft/10 to-transparent dark:from-white/[0.02] pointer-events-none timer-dial-shadow"></div>
              <!-- Bezel ring for premium feel -->
              <div class="absolute inset-[2.5%] rounded-full border border-hairline/10 pointer-events-none"></div>

              <!-- Progress Ring SVG -->
              <svg viewBox="0 0 100 100" class="w-full h-full transform -rotate-90 relative z-10" aria-hidden="true">
                <defs>
                  <linearGradient id="timer-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="var(--color-link)" />
                    <stop offset="100%" stop-color="var(--color-link)" stop-opacity="0.6" />
                  </linearGradient>
                </defs>
                <circle id="timer-progress-bg" cx="50" cy="50" r="45" stroke="currentColor" stroke-width="3" opacity="0.06" fill="transparent" />
                <circle id="timer-progress-ring" cx="50" cy="50" r="45" stroke="url(#timer-gradient)" stroke-width="3.5" stroke-linecap="round" fill="transparent" stroke-dasharray="282.74" stroke-dashoffset="0" />
                <!-- Glowing dot at the end of the progress arc -->
                <circle id="timer-progress-dot-glow" cx="50" cy="5" r="7" fill="var(--color-link)" opacity="0.15" class="transition-all duration-700 ease-out" />
                <circle id="timer-progress-dot" cx="50" cy="5" r="3.5" fill="var(--color-link)" class="transition-all duration-700 ease-out" />
              </svg>

              <!-- Center content: Activity badge -- Status -- Countdown -- Goal label -- Next step -->
              <div class="absolute flex flex-col items-center justify-center text-center z-20 px-6 w-full select-none">
                <!-- Activity pill (kept for JS compatibility — hidden; activity shown in left column) -->
                <span id="timer-active-category" class="hidden"></span>
                <!-- Session status -->
                <span id="timer-session-text" class="text-xs font-medium text-body/80 mb-2">Clear your mind. You've got this.</span>
                <!-- Kept for JS compatibility (hidden, wraps timer-session-text in DOM) -->
                <span id="timer-session-label" class="hidden"></span>
                <!-- Countdown -->
                <span id="timer-countdown" aria-live="polite" aria-atomic="true" class="text-5xl md:text-6xl font-bold tracking-tighter text-ink leading-none tabular-nums" style="font-variant-numeric: tabular-nums;">
                  25:00
                </span>
                <!-- Goal text when session active -->
                <span id="timer-active-goal" class="text-xs font-medium text-mute/60 mt-2 max-w-[180px] truncate"></span>
                <!-- Next step hint -->
                <span id="timer-next-step" class="text-[11px] font-medium text-mute/60 mt-1.5 hidden max-w-[180px] truncate"></span>
                <!-- Checkpoint ratio -->
                <span id="timer-milestone-ratio" class="text-[10px] text-mute/50 mt-0.5 tabular-nums"></span>
              </div>
            </div>

            <!-- Controls Panel -->
            <div class="flex items-center gap-2.5 mt-0.5 w-full max-w-[290px] justify-center">
              <!-- Skip button -->
              <button type="button" id="skip-btn" class="control-btn w-11 h-11 rounded-2xl bg-canvas-soft/60 hover:bg-canvas-soft-2/80 active:scale-95 flex items-center justify-center transition-all duration-200 cursor-pointer text-mute hover:text-ink disabled:opacity-25 disabled:pointer-events-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link/30" disabled title="End this session" aria-label="End this focus session">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19"/></svg>
              </button>

              <!-- Primary CTA: Play / Pause -->
              <button type="button" id="play-pause-btn" aria-pressed="false" aria-label="Start focus session" class="btn-primary px-8 h-11 bg-gradient-to-b from-link to-link/90 text-white hover:from-link-hover hover:to-link-hover/90 hover:shadow-lg hover:shadow-link/20 active:scale-[0.97] text-sm font-bold rounded-2xl transition-all duration-200 cursor-pointer flex items-center gap-2.5 justify-center min-w-[140px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link/50">
                <svg id="play-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <svg id="pause-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                <span id="play-btn-text">I'm ready</span>
              </button>

              <!-- Fullscreen trigger -->
