---
import Layout from "../layouts/Layout.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Tooltails", "item": "https://tooltails.com" },
    { "@type": "ListItem", "position": 2, "name": "Digital Store", "item": "https://tooltails.com/digital-store" }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AI-Powered Digital Store",
  "url": "https://tooltails.com/digital-store",
  "description": "Browse digital products with AI-powered recommendations. A smart storefront that learns your preferences and suggests relevant items.",
  "applicationCategory": "Shopping",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript"
};
---

<Layout
  title="AI-Powered Digital Store – Smart Product Recommendations | Tooltails"
  description="Browse digital products with AI-powered recommendations. Smart suggestions based on your interests."
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />

  <div class="bg-gradient-to-b from-fuchsia-50/20 to-transparent min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl md:text-4xl font-black tracking-tight text-ink">
            AI Digital <span class="text-fuchsia-600">Store</span>
          </h1>
          <p class="text-sm text-mute mt-1">Smart recommendations powered by your interests</p>
        </div>
        <button id="cart-btn" class="relative inline-flex items-center gap-2 px-4 py-2.5 text-xs font-extrabold text-white bg-fuchsia-600 rounded-xl hover:bg-fuchsia-700 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="21" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          Cart
          <span id="cart-count" class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-rose-500 text-white text-[9px] font-black flex items-center justify-center hidden">0</span>
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <div class="lg:col-span-3">
          <div class="flex items-center gap-3 mb-6">
            <div class="relative flex-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-mute"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="search-input" type="text" class="w-full pl-10 pr-4 py-2.5 text-sm bg-canvas border border-hairline rounded-xl focus:outline-none focus:ring-2 focus:ring-fuchsia-500/30 focus:border-fuchsia-400 transition-all" placeholder="Search products...">
            </div>
            <select id="category-filter" class="px-4 py-2.5 text-xs font-bold text-ink bg-canvas border border-hairline rounded-xl focus:outline-none focus:ring-2 focus:ring-fuchsia-500/30 appearance-none cursor-pointer">
              <option value="all">All Categories</option>
              <option value="templates">Templates</option>
              <option value="ebooks">eBooks & Guides</option>
              <option value="tools">Developer Tools</option>
              <option value="design">Design Assets</option>
              <option value="courses">Courses</option>
            </select>
          </div>

          <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
          <div id="no-results" class="hidden text-center py-16">
            <p class="text-sm text-mute">No products found matching your search.</p>
          </div>
        </div>

        <div class="lg:col-span-1">
          <div class="bg-canvas border border-hairline rounded-2xl p-4 sticky top-24">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-7 h-7 rounded-lg bg-fuchsia-100/60 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-fuchsia-600"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <p class="text-xs font-bold text-ink">AI Recommendations</p>
            </div>
            <p id="ai-hint" class="text-[11px] text-mute mb-3">Click on any product to get AI-powered recommendations based on your interests.</p>
            <div id="ai-recs" class="space-y-2"></div>
            <div id="ai-empty" class="text-center py-6">
              <p class="text-[11px] text-mute">Browse products to see suggestions</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="cart-sidebar" class="fixed inset-0 z-50 pointer-events-none">
    <div id="cart-overlay" class="absolute inset-0 bg-black/20 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>
    <div id="cart-panel" class="absolute top-0 right-0 h-full w-full max-w-md bg-canvas border-l border-hairline shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col">
      <div class="flex items-center justify-between p-5 border-b border-hairline">
        <h2 class="text-sm font-bold text-ink">Shopping Cart</h2>
        <button id="close-cart" class="w-8 h-8 rounded-lg bg-canvas-soft-2 flex items-center justify-center hover:bg-hairline transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="cart-items" class="flex-1 overflow-y-auto p-5 space-y-3">
        <div class="text-center py-12">
          <div class="w-12 h-12 rounded-2xl bg-fuchsia-100/60 flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-fuchsia-600"><circle cx="8" cy="21" r="1"/><circle cx="21" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
          <p class="text-sm font-bold text-ink mb-1">Your cart is empty</p>
          <p class="text-xs text-mute">Browse products and add items you like.</p>
        </div>
      </div>
      <div id="cart-footer" class="hidden p-5 border-t border-hairline">
        <div class="flex items-center justify-between mb-4">
          <p class="text-xs font-bold text-ink uppercase tracking-wider">Total</p>
          <p id="cart-total" class="text-lg font-black text-fuchsia-600">$0.00</p>
        </div>
        <button id="checkout-btn" class="w-full py-3 text-sm font-extrabold text-white bg-fuchsia-600 rounded-xl hover:bg-fuchsia-700 active:scale-[0.98] transition-all">
          Proceed to Checkout
        </button>
      </div>
    </div>
  </div>

  <div id="checkout-modal" class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none">
    <div id="checkout-overlay" class="absolute inset-0 bg-black/30 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>
    <div id="checkout-content" class="relative bg-canvas border border-hairline rounded-2xl shadow-2xl w-full max-w-lg mx-4 p-6 scale-95 opacity-0 transition-all duration-300 pointer-events-auto max-h-[90vh] overflow-y-auto">
      <button id="close-checkout" class="absolute top-4 right-4 w-8 h-8 rounded-lg bg-canvas-soft-2 flex items-center justify-center hover:bg-hairline transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <h2 class="text-lg font-bold text-ink mb-6">Checkout</h2>
      <div id="checkout-summary" class="space-y-2 mb-6"></div>
      <div class="border-t border-hairline pt-4 mb-6">
        <div class="flex items-center justify-between text-sm font-bold text-ink mb-1">
          <span>Total</span>
          <span id="checkout-total" class="text-fuchsia-600">$0.00</span>
        </div>
      </div>
      <div class="space-y-3 mb-6">
        <input type="email" id="checkout-email" class="w-full px-4 py-2.5 text-sm bg-canvas-soft border border-hairline rounded-xl focus:outline-none focus:ring-2 focus:ring-fuchsia-500/30" placeholder="Your email address">
        <select id="checkout-payment" class="w-full px-4 py-2.5 text-sm bg-canvas-soft border border-hairline rounded-xl focus:outline-none focus:ring-2 focus:ring-fuchsia-500/30">
          <option value="">Select payment method...</option>
          <option value="card">Credit Card</option>
          <option value="paypal">PayPal</option>
          <option value="crypto">Cryptocurrency</option>
        </select>
      </div>
      <button id="place-order-btn" class="w-full py-3 text-sm font-extrabold text-white bg-fuchsia-600 rounded-xl hover:bg-fuchsia-700 active:scale-[0.98] transition-all">
        Place Order
      </button>
    </div>
  </div>

  <div id="toast" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white text-xs font-bold px-5 py-3 rounded-2xl shadow-2xl translate-y-4 opacity-0 transition-all duration-300 pointer-events-none">
  </div>
</Layout>

<script src="/src/scripts/digital-store.ts"></script>