---
import Layout from "../layouts/Layout.astro";
import Input from "../components/ui/Input.astro";
import Button from "../components/ui/Button.astro";
import FAQ from "../components/ui/FAQ.astro";
import HowToUseModal from "../components/ui/HowToUseModal.astro";

const howToUseSteps = [
  {
    title: "Select a Focus Mode",
    description: "Choose Pomodoro (25 min), Short Break (5 min), or Long Break (15 min)."
  },
  {
    title: "Set Your Task",
    description: "Type a custom task in the input box or click a quick-start template (Study, Writing, Coding, or Reading)."
  },
  {
    title: "Run the Timer",
    description: "Click Start to begin focusing. Mark tasks as complete to increase your daily sessions, build streaks, and boost your Focus Score."
  }
];
const howToUseTip = "Adjust interval durations and sound alerts in the timer settings menu.";

const faqItems = [
  {
    question: "What should I do during a 5-minute Pomodoro break?",
    answer: "Step away from your screen. Stand up, stretch, grab a glass of water, or do light breathing exercises. Avoid browsing social media or checking email, as screen-based activities maintain cognitive fatigue rather than restoring attentional reserves."
  },
  {
    question: "What if I finish my task before the 25-minute timer ends?",
    answer: "Use the remaining time for 'overlearning' or reviewing what you just completed: proofread your writing, refactor the code you just wrote, review study notes, or organize your next priority task."
  },
  {
    question: "How many Pomodoro sessions should I do each day?",
    answer: "Most knowledge workers find that 4 to 8 focused 25-minute sessions (equal to 2 to 4 hours of pure uninterrupted deep focus) produce exceptional daily output without causing mental burnout."
  },
  {
    question: "Can I customize the timer intervals?",
    answer: "Yes. Click the settings gear icon on the timer to adjust focus length (e.g., 50 minutes for deep work), short breaks (5 to 10 minutes), and long breaks (15 to 30 minutes) to match your personal cadence."
  },
  {
    question: "Is the Pomodoro Technique effective for ADHD?",
    answer: "Yes. The technique provides clear external structure, lowers the threshold of initiation ('I only have to work for 25 minutes'), and gamifies attention with short, immediate milestones and regular dopamine-replenishing breaks."
  }
];

const canonicalUrl = "https://tooltails.com/pomodoro-timer/";
---

<Layout
  title="Pomodoro Timer — Free Focus & Productivity Timer"
  description="Stay focused, build streaks, measure productivity, and turn work sessions into completed goals. Free Pomodoro Timer with task tracking, focus analytics, and daily streaks. No login required."
  image="/og-image.png"
>

  <!-- ===== HERO SECTION ===== -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-4">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 border-b border-hairline/60 pb-5">
      <div>
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink mb-1.5 leading-tight">
          Pomodoro Timer
        </h1>
        <p class="text-sm md:text-base text-mute font-normal">
          A focused productivity space designed to protect your attention, rhythm, and workflow.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <HowToUseModal toolName="Pomodoro Timer" steps={howToUseSteps} tip={howToUseTip} />
      </div>
    </div>
  </div>

  <!-- ===== MAIN CONTENT ===== -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12 pt-4">

    <!-- ===== TWO-COLUMN LAYOUT ===== -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.3fr] gap-4 lg:gap-6 items-start">

      <!-- ===== LEFT COLUMN (Focus, Glance, Recent) ===== -->
      <div class="order-2 flex flex-col gap-4 lg:col-start-1 lg:row-start-1 lg:row-end-4 w-full">
        <!-- Today's Focus Card -->
        <div aria-busy="true" class="bg-canvas rounded-3xl border border-hairline shadow-sm p-5 sm:p-6 transition-all duration-200 hover:shadow-md hover:border-link/30">
          <div class="flex items-center gap-2.5 mb-3 border-b border-hairline/60 pb-3">
            <svg class="w-4 h-4 text-link shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
            <h2 class="text-base font-bold tracking-tight text-ink">Today's Focus</h2>
            <span id="tasks-count" class="text-[10px] font-bold uppercase tracking-wider text-mute ml-auto bg-canvas-soft-2 px-2.5 py-1 rounded-full border border-hairline">🌱 Nothing planned</span>
          </div>
          <ul id="tasks-list" class="space-y-1">
            <li class="text-sm text-mute text-center py-6 leading-relaxed" id="tasks-empty">What do you want to work on today?</li>
          </ul>
          <div class="flex gap-2 mt-2 pt-3 border-t border-hairline/60">
            <input id="task-add-input" type="text" placeholder="Add a task…" class="flex-1 h-11 px-3.5 text-sm bg-canvas-soft-2 border border-hairline rounded-xl text-ink placeholder:text-mute outline-none focus:border-link focus:ring-2 focus:ring-link/10 transition-all" autocomplete="off" />
            <button id="task-add-btn" class="h-11 px-5 text-sm font-semibold text-white bg-link rounded-xl hover:bg-link-hover transition-all shrink-0 cursor-pointer active:scale-95 shadow-sm shadow-link/20" type="button" style="touch-action: manipulation">Add task</button>
          </div>
          <div id="quick-start-section" class="mt-3 pt-3 border-t border-hairline/60">
            <span class="text-[11px] font-bold uppercase tracking-wider text-mute block mb-2">Quick start</span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <button type="button" class="quick-start-btn flex flex-col items-center justify-center min-h-[58px] py-2 px-3 rounded-xl border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-link/30 transition-all cursor-pointer active:scale-95 text-center w-full" data-template="Study" style="touch-action: manipulation">
                <span class="text-xs font-bold text-ink">Study</span>
                <span class="text-[10px] text-mute font-medium mt-0.5 leading-none whitespace-nowrap">Review, notes</span>
              </button>
              <button type="button" class="quick-start-btn flex flex-col items-center justify-center min-h-[58px] py-2 px-3 rounded-xl border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-link/30 transition-all cursor-pointer active:scale-95 text-center w-full" data-template="Writing" style="touch-action: manipulation">
                <span class="text-xs font-bold text-ink">Writing</span>
                <span class="text-[10px] text-mute font-medium mt-0.5 leading-none whitespace-nowrap">Draft, outline</span>
              </button>
              <button type="button" class="quick-start-btn flex flex-col items-center justify-center min-h-[58px] py-2 px-3 rounded-xl border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-link/30 transition-all cursor-pointer active:scale-95 text-center w-full" data-template="Coding" style="touch-action: manipulation">
                <span class="text-xs font-bold text-ink">Coding</span>
                <span class="text-[10px] text-mute font-medium mt-0.5 leading-none whitespace-nowrap">Feature, debug</span>
              </button>
              <button type="button" class="quick-start-btn flex flex-col items-center justify-center min-h-[58px] py-2 px-3 rounded-xl border border-hairline bg-canvas hover:bg-canvas-soft-2 hover:border-link/30 transition-all cursor-pointer active:scale-95 text-center w-full" data-template="Reading" style="touch-action: manipulation">
                <span class="text-xs font-bold text-ink">Reading</span>
                <span class="text-[10px] text-mute font-medium mt-0.5 leading-none whitespace-nowrap">Articles, books</span>
              </button>
            </div>
          </div>
          <div id="task-input-container" class="hidden">
            <input id="task-input" type="text" class="hidden" />
          </div>
          <div id="active-task-container" class="hidden">
            <span id="active-task-name"></span>
          </div>
          <div id="active-task-footer" class="hidden">
            <button type="button" id="btn-complete-task" class="hidden"></button>
          </div>
        </div>
        <!-- 4-Stat Bar -->
        <div aria-busy="true" class="bg-canvas rounded-3xl border border-hairline shadow-sm p-4 sm:p-5 transition-all duration-200 hover:shadow-md hover:border-link/30 relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-link to-blue-500"></div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
            <div>
              <span class="text-[10px] sm:text-[11px] font-bold text-mute uppercase tracking-widest">Sessions</span>
              <div class="flex items-baseline gap-0.5 mt-1">
                <span id="stat-sessions" class="text-xl sm:text-2xl font-extrabold tracking-tight text-ink leading-none" aria-live="polite">0</span>
                <span class="text-xs text-mute font-medium">/ <span id="stat-goal-total">4</span></span>
              </div>
              <div class="w-full h-1 bg-hairline/60 rounded-full overflow-hidden mt-2">
                <div id="stat-goal-bar" class="bg-link h-full rounded-full transition-colors duration-500" style="width:0%"></div>
              </div>
            </div>
            <div>
              <span class="text-[10px] sm:text-[11px] font-bold text-mute uppercase tracking-widest">Tasks done</span>
              <div class="flex items-baseline mt-1">
                <span id="stat-tasks" class="text-xl sm:text-2xl font-extrabold tracking-tight text-emerald-600 dark:text-emerald-400 leading-none" aria-live="polite">0</span>
              </div>
              <div id="tasks-completed-sub" class="text-[11px] text-mute mt-1.5 font-medium leading-tight">Add a task</div>
            </div>
            <div>
              <span class="text-[10px] sm:text-[11px] font-bold text-mute uppercase tracking-widest">Time spent</span>
              <div class="flex items-baseline mt-1">
                <span id="stat-total-time" class="text-xl sm:text-2xl font-extrabold tracking-tight text-link leading-none" aria-live="polite">0m</span>
              </div>
              <div class="text-[11px] text-mute mt-1.5 font-medium leading-tight">Ready when you are</div>
            </div>
            <div>
              <span class="text-[10px] sm:text-[11px] font-bold text-mute uppercase tracking-widest">Focus score</span>
              <div class="flex items-baseline gap-0.5 mt-1">
                <span id="stat-focus-score" class="text-xl sm:text-2xl font-extrabold tracking-tight text-ink leading-none" aria-live="polite">0</span>
                <span class="text-xs text-mute font-medium">/100</span>
              </div>
              <span id="focus-score-label" class="text-[10px] font-medium text-link hidden"></span>
              <div id="focus-score-label-fallback" class="text-[11px] text-mute mt-1.5 font-medium leading-tight">Start a session</div>
            </div>
          </div>
          <p id="stat-encouragement" class="text-xs text-mute mt-3 pt-2.5 border-t border-hairline/60 leading-relaxed" aria-live="polite">Small progress still counts. Start where you are.</p>
          <span id="session-counter-text" class="hidden"></span>
          <span id="stat-goal-percentage" class="hidden">0%</span>
        </div>

        <!-- 4. UTILITY GRID CONTAINER (2x2 Grid) -->
        <div class="w-full">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- Card 1: Your Streak -->
            <div class="bg-canvas rounded-3xl border border-hairline shadow-sm p-4 sm:p-5 flex flex-col justify-between min-h-[140px] transition-all duration-200 hover:shadow-md hover:border-link/30 relative overflow-hidden">
              <div class="flex flex-col grow">
                <div class="flex items-center gap-2 mb-2 border-b border-hairline/60 pb-2">
                  <svg class="w-4 h-4 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                  <span class="text-[11px] font-bold uppercase text-mute tracking-widest">Your Streak</span>
                </div>
                <div class="flex items-center justify-between text-xs text-ink mt-1 mb-2 bg-canvas-soft-2 px-3 py-2 rounded-2xl border border-hairline select-none">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-amber-500/10 flex items-center justify-center text-xs shrink-0 select-none">🔥</div>
                    <div class="flex flex-col">
                      <span class="text-[9px] font-semibold uppercase tracking-wider text-mute leading-none">Streak</span>
                      <span class="text-xs sm:text-sm font-extrabold text-ink mt-0.5" aria-live="polite"><span id="stat-streak">0</span><span class="text-[9px] text-mute font-bold ml-0.5">d</span></span>
                    </div>
                  </div>
                  <div class="w-px h-6 bg-hairline"></div>
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-link/10 flex items-center justify-center text-xs shrink-0 select-none">🏆</div>
                    <div class="flex flex-col">
                      <span class="text-[9px] font-semibold uppercase tracking-wider text-mute leading-none">Best</span>
                      <span class="text-xs sm:text-sm font-extrabold text-ink mt-0.5" aria-live="polite"><span id="stat-longest-streak">0</span><span class="text-[9px] text-mute font-bold ml-0.5">d</span></span>
                    </div>
                  </div>
                  <div class="w-px h-6 bg-hairline"></div>
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-blue-500/10 flex items-center justify-center text-xs shrink-0 select-none">⚡</div>
                    <div class="flex flex-col">
                      <span class="text-[9px] font-semibold uppercase tracking-wider text-mute leading-none">Score</span>
                      <span class="text-xs sm:text-sm font-extrabold text-ink mt-0.5"><span id="dash-score">0</span></span>
                    </div>
                  </div>
                </div>
                <p id="streak-context" class="text-[11px] text-mute mt-2 leading-relaxed font-medium border-l-2 border-link/40 pl-2">Start today to begin your streak.</p>
                <span id="streak-context-fallback" class="hidden"></span>
              </div>
              <div class="mt-2 pt-2 border-t border-hairline/60 shrink-0">
                <span id="heatmap-week-label" class="hidden"></span>
                <div id="weekly-heatmap" class="flex gap-1 min-h-[20px] items-end">
                  <div class="text-[10px] text-mute w-full text-center">No sessions yet</div>
                </div>
                <!-- Dynamic day labels row placeholder -->
                <div id="weekly-heatmap-labels" class="flex gap-1 mt-1 select-none"></div>
                <div class="flex items-center justify-between mt-2 pt-1.5 border-t border-hairline/60 select-none">
                  <span class="text-[9px] text-mute font-semibold">Activity (Past 7 days)</span>
                  <div class="flex gap-1">
                    <span class="w-2 h-2 rounded-sm bg-slate-100 dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700"></span>
                    <span class="w-2 h-2 rounded-sm bg-blue-200 dark:bg-blue-900/40 border border-blue-300/40"></span>
                    <span class="w-2 h-2 rounded-sm bg-blue-300 dark:bg-blue-800/50 border border-blue-400/40"></span>
                    <span class="w-2 h-2 rounded-sm bg-blue-400 dark:bg-blue-700/60 border border-blue-500/40"></span>
                    <span class="w-2 h-2 rounded-sm bg-link dark:bg-link border border-link"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card 2: Daily Target -->
            <div class="bg-canvas rounded-3xl border border-hairline shadow-sm p-4 sm:p-5 flex flex-col justify-between min-h-[140px] transition-all duration-200 hover:shadow-md hover:border-link/30 relative overflow-hidden">
              <div class="flex flex-col grow">
                <div class="flex items-center gap-2 mb-2 border-b border-hairline/60 pb-2">
                  <svg class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                  <span class="text-[11px] font-bold uppercase text-mute tracking-widest">Daily Target</span>
                </div>
                <div class="flex flex-col mt-2">
                  <span id="daily-target-large-text" class="text-base sm:text-lg font-extrabold tracking-tight text-ink leading-none" aria-live="polite">0 of 4 sessions</span>
                  <p id="daily-target-subtext" class="text-xs text-mute mt-1.5 leading-normal font-medium">Keep going, you've got this!</p>
                </div>
              </div>
              <div class="flex items-center gap-2 mt-auto pt-3 w-full">
                <div class="flex-1 h-2 bg-hairline/60 rounded-full overflow-hidden">
                  <div id="daily-target-bar" class="bg-gradient-to-r from-emerald-500 to-green-500 shadow-sm h-full rounded-full transition-colors duration-500" style="width:0%"></div>
                </div>
                <span id="daily-target-pct" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 shrink-0">0%</span>
                <span id="daily-target-text" class="hidden">0/4</span>
              </div>
            </div>

          </div>
        </div>

        <!-- 5. A NOTE FOR TODAY -->
        <div class="w-full">
          <div class="bg-canvas rounded-3xl border border-hairline shadow-sm p-4 sm:p-5 transition-all duration-200 hover:shadow-md hover:border-link/30">
            <div class="flex items-center gap-2 mb-2 border-b border-hairline/60 pb-2">
              <svg class="w-4 h-4 text-mute shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              <h2 class="text-xs sm:text-sm font-bold tracking-tight text-ink">A Note for Today</h2>
            </div>
            <div id="daily-timeline-content" class="space-y-0">
              <div id="focus-insight-card">
                <p id="focus-insight-text" class="text-xs text-body leading-relaxed">☕ One focus block is enough.</p>
                <button type="button" id="focus-insight-refresh" class="mt-1 text-xs font-semibold text-link hover:underline transition-colors cursor-pointer" aria-label="Show another insight" style="touch-action: manipulation">Show another</button>
              </div>
            </div>
            <span id="timeline-badge" class="hidden"></span>
          </div>
        </div>

      </div>

      <!-- 2. TIMER + SETTINGS + WIDGETS -->
      <div class="order-1 flex flex-col gap-4 lg:col-start-2 lg:row-start-1 lg:row-end-4 lg:sticky lg:top-4" style="overscroll-behavior: contain">
        <div aria-busy="true" class="bg-canvas rounded-[2.5rem] border border-hairline shadow-sm ring-1 ring-black/[0.03] dark:ring-white/[0.03] p-6 sm:p-8 transition-all duration-200 hover:shadow-md hover:border-link/30 relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-link via-blue-500 to-indigo-500"></div>
          <div class="flex gap-1 p-1 bg-canvas-soft-2 rounded-full w-full max-w-[340px] mx-auto mb-4 border border-hairline/60">
            <button type="button" id="mode-pomodoro" class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-full transition-all cursor-pointer bg-link text-white shadow-sm ring-1 ring-link/20" aria-label="Switch to Pomodoro focus session" style="touch-action: manipulation">Pomodoro</button>
            <button type="button" id="mode-short" class="flex-1 py-2 text-xs sm:text-sm font-bold text-mute hover:text-ink rounded-full transition-all cursor-pointer" aria-label="Switch to short break" style="touch-action: manipulation">Short Break</button>
            <button type="button" id="mode-long" class="flex-1 py-2 text-xs sm:text-sm font-bold text-mute hover:text-ink rounded-full transition-all cursor-pointer" aria-label="Switch to long break" style="touch-action: manipulation">Long Break</button>
          </div>
          <div class="flex flex-col items-center gap-2">
            <div id="timer-ring-container" class="relative w-full max-w-[240px] sm:max-w-[280px] md:max-w-[310px] aspect-square mx-auto flex items-center justify-center">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 256 256" style="filter: drop-shadow(0 0 16px rgba(37,99,235,0.12))">
                <defs>
                  <filter id="ring-glow"><feGaussianBlur stdDeviation="5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
                </defs>
                <circle cx="128" cy="128" r="120" stroke="currentColor" stroke-width="1" fill="transparent" class="text-link/[0.04]" />
                <circle cx="128" cy="128" r="116" stroke="currentColor" stroke-width="4" fill="transparent" class="text-hairline/20" />
                <circle id="timer-progress-ring" cx="128" cy="128" r="116" stroke="currentColor" stroke-width="10" fill="transparent" stroke-dasharray="728.85" stroke-dashoffset="0" stroke-linecap="round" class="text-link transition-colors duration-1000 ease-linear drop-shadow-[0_0_8px_rgba(37,99,235,0.35)]" filter="url(#ring-glow)" />
              </svg>
              <div class="absolute flex flex-col items-center justify-center select-none">
                <span id="timer-display" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter text-ink tabular-nums leading-none">25:00</span>
                <span id="timer-status-text" class="text-[11px] sm:text-xs font-bold text-link/80 mt-2 uppercase tracking-[0.2em]">Focus time</span>
              </div>
              <div id="timer-pulse" class="absolute inset-0 rounded-full border-[3px] border-link/15 pointer-events-none hidden"></div>
              <div id="celebration-container" class="absolute inset-0 pointer-events-none hidden"></div>
            </div>
            <div id="timer-phase-container" class="text-center min-h-[14px]">
              <span id="timer-phase" class="text-sm font-semibold text-mute opacity-0 transition-colors duration-500">Whenever you're ready, begin.</span>
            </div>
            <div class="flex items-center gap-3 sm:gap-4 mt-2">
              <button type="button" id="btn-reset" class="w-11 h-11 rounded-full border border-hairline bg-canvas text-mute hover:text-ink hover:bg-canvas-soft-2 hover:border-link/30 transition-all flex items-center justify-center cursor-pointer active:scale-90 shadow-sm" title="Reset" aria-label="Reset Timer" style="touch-action: manipulation">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              </button>
              <button type="button" id="btn-play-pause" class="w-16 h-16 rounded-full bg-link text-white hover:bg-link-hover hover:shadow-xl hover:shadow-link/30 transition-all flex items-center justify-center cursor-pointer active:scale-95 shadow-lg shadow-link/25" title="Start Session" aria-label="Start or Pause Timer" style="touch-action: manipulation">
                <svg id="icon-play" class="ml-0.5" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                <svg id="icon-pause" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>
              </button>
              <button type="button" id="btn-skip" class="w-11 h-11 rounded-full border border-hairline bg-canvas text-mute hover:text-ink hover:bg-canvas-soft-2 hover:border-link/30 transition-all flex items-center justify-center cursor-pointer active:scale-90 shadow-sm" title="Skip" aria-label="Skip Timer" style="touch-action: manipulation">
