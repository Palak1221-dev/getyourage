---
import Layout from "../../layouts/Layout.astro";
import { products } from "../../data/products";
import ProductCard from "../../components/digital-store/ProductCard.astro";
---

<Layout
  title="Personalized Digital Planners & Systems — Tooltails Store"
  description="AI-powered planners personalized for your goals, routines, and mind. Four flagship systems: Study Planner Pro, Master Your Day, Wellness Journal, and Goal Roadmap."
  hideFooter={true}
>
  <div class="digital-store-root min-h-screen bg-[#FAF9FC] text-stone-900 font-sans pb-20 relative overflow-hidden">
    
    <!-- Ambient Background Blur Halos -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-200/25 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-40 right-1/4 w-96 h-96 bg-amber-100/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- MAIN STOREFRONT CONTAINER -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14 sm:space-y-18 pt-8">

      <!-- HERO SECTION CARD (WARM IVORY BACKGROUND) -->
      <section class="relative rounded-3xl bg-gradient-to-br from-[#FCFBF8] via-[#FAF9F5] to-[#F5F3EF] p-8 sm:p-14 lg:p-16 overflow-hidden border border-stone-200/70 shadow-xs">
        
        <!-- Soft Lavender Radial Glow behind Notebook -->
        <div class="absolute right-12 top-1/2 -translate-y-1/2 w-96 h-96 bg-radial from-[#F3E8FF]/40 via-purple-50/20 to-transparent rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center relative z-10">
          
          <!-- Left Hero Content -->
          <div class="lg:col-span-7 space-y-8">
            
            <!-- Floating Pill Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 backdrop-blur-md border border-stone-200/80 text-[#7C3AED] text-xs font-semibold shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>✨ Digital Planners Made Personal</span>
            </div>

            <div class="space-y-4">
              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-stone-900 leading-[1.12]">
                <span class="sr-only">Digital Store Planners — </span>
                Plan smarter.<br/>
                Stay <span class="bg-gradient-to-r from-[#7C3AED] via-purple-600 to-indigo-600 bg-clip-text text-transparent">on track.</span>
              </h1>

              <p class="text-base sm:text-lg text-stone-600 font-normal leading-relaxed max-w-xl">
                AI-powered planners personalized for your goals, routines, and mind. Crafted with luxury typography and interactive page layouts.
              </p>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 sm:gap-5 pt-1">
              <a href="#systems" class="px-8 py-4 rounded-full bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-bold text-sm shadow-lg shadow-purple-600/20 hover:shadow-2xl hover:shadow-purple-600/30 hover:-translate-y-0.5 transition-all active:translate-y-0 flex items-center gap-2">
                <span>Browse Planners</span>
                <span class="text-base">&rarr;</span>
              </a>
              <a href="#how-it-works" class="px-8 py-4 rounded-full bg-white/90 backdrop-blur-xs hover:bg-stone-50 text-[#7C3AED] border border-stone-200/80 font-bold text-sm shadow-2xs hover:-translate-y-0.5 transition-all flex items-center gap-2">
                <span>How it works</span>
                <span aria-hidden="true" class="text-xs">&#9655;</span>
              </a>
            </div>

            <!-- Trust Bar -->
            <div class="flex flex-wrap items-center gap-8 pt-4 text-xs font-semibold text-stone-600 border-t border-stone-200/60">
              <span class="sr-only">Rating 4.9 · 10,000+ Planners Sold</span>
              <span class="flex items-center gap-2 text-stone-700 font-semibold"><span aria-hidden="true">📥</span> Instant Download</span>
              <span class="flex items-center gap-2 text-stone-700 font-semibold"><span aria-hidden="true">🖨️</span> Printable PDF</span>
              <span class="flex items-center gap-2 text-stone-700 font-semibold"><span aria-hidden="true">♾️</span> Lifetime Access</span>
            </div>

          </div>

          <!-- Right Hero — Luxury Editorial Stationery Presentation -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end items-center py-4 lg:py-0">
            <div class="relative w-full max-w-[500px] sm:max-w-[540px] h-[450px] sm:h-[490px] flex items-center justify-center select-none">

              <!-- Faint Ambient Warm Backdrop Glow -->
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[360px] h-[360px] bg-radial from-purple-100/30 via-amber-50/20 to-transparent blur-3xl rounded-full pointer-events-none -z-20"></div>

              <!-- Faint Background Botanical Fine Line Art -->
              <div class="absolute -top-2 right-2 pointer-events-none text-stone-300/35 z-0">
                <svg width="95" height="95" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1">
                  <path d="M50 90C50 90 45 60 70 30C75 24 85 15 90 10M70 30C60 35 40 30 30 20M50 60C40 62 25 55 15 45"/>
                  <circle cx="90" cy="10" r="2" fill="currentColor"/>
                </svg>
              </div>

              <!-- Realistic Soft Ground Ambient Shadow -->
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[84%] h-7 bg-stone-950/12 blur-xl rounded-full pointer-events-none -z-10"></div>

              <!-- MOCKUP STACK CONTAINER (+15% VISUAL WEIGHT) -->
              <div class="relative w-[295px] sm:w-[335px] h-[390px] sm:h-[435px] flex items-center justify-center">

                <!-- 0. UNDERNEATH PAPER DECK STACK -->
                <div class="absolute -bottom-2 -left-2 w-[295px] sm:w-[335px] h-[390px] sm:h-[435px] bg-[#FAF7F2] rounded-xl border border-stone-200/90 shadow-sm transform -rotate-1 z-0 opacity-90"></div>

                <!-- 1. LEFT PEEK: PREMIUM MONTHLY PLANNER PAGE (18% Visible) -->
                <div class="absolute -top-3.5 -left-5 sm:-left-7 w-[285px] sm:w-[325px] h-[380px] sm:h-[425px] bg-[#FCFBF9] rounded-xl border border-stone-200/90 shadow-md shadow-stone-900/5 transform -rotate-4 z-5 opacity-95 p-5 flex flex-col justify-between overflow-hidden select-none">
                  <div class="space-y-3">
                    <div class="flex items-center justify-between border-b border-stone-200/50 pb-2">
                      <span class="text-[8.5px] font-bold tracking-[0.25em] text-stone-500 uppercase font-mono">MONTHLY OVERVIEW</span>
                      <span class="text-[8px] font-medium text-stone-400">OCTOBER</span>
                    </div>
                    <!-- Mini Calendar Matrix -->
                    <div class="grid grid-cols-7 gap-1 text-center text-[7.5px] text-stone-400 font-mono pt-1">
                      <span class="font-bold text-stone-600">M</span><span class="font-bold text-stone-600">T</span><span class="font-bold text-stone-600">W</span><span class="font-bold text-stone-600">T</span><span class="font-bold text-stone-600">F</span><span class="font-bold text-stone-600">S</span><span class="font-bold text-stone-600">S</span>
                      <span>1</span><span>2</span><span>3</span><span class="bg-purple-100 text-purple-700 font-bold rounded-xs">4</span><span>5</span><span>6</span><span>7</span>
                    </div>
                  </div>
                  <span class="text-[8px] font-mono text-stone-300">PAGE 02</span>
                </div>

                <!-- 2. RIGHT PEEK: ELEGANT WEEKLY PLANNER PAGE (18% Visible) -->
                <div class="absolute -top-2 -right-5 sm:-right-7 w-[285px] sm:w-[325px] h-[380px] sm:h-[425px] bg-[#FCFBF9] rounded-xl border border-stone-200/90 shadow-md shadow-stone-900/5 transform rotate-4 z-10 opacity-95 p-5 flex flex-col justify-between overflow-hidden select-none">
                  <div class="space-y-3">
                    <div class="flex items-center justify-between border-b border-stone-200/50 pb-2">
                      <span class="text-[8.5px] font-bold tracking-[0.25em] text-stone-500 uppercase font-mono">WEEKLY SPREAD</span>
                      <span class="text-[8px] font-medium text-purple-700/80">WEEK 42</span>
                    </div>
                    <div class="space-y-2 text-[8px] font-mono text-stone-400">
                      <div class="border-b border-stone-200/40 pb-1 flex justify-between">
                        <span class="font-bold text-stone-600">MONDAY</span>
                        <span class="text-stone-300">Deep Work</span>
                      </div>
                      <div class="border-b border-stone-200/40 pb-1 flex justify-between">
                        <span class="font-bold text-stone-600">TUESDAY</span>
                        <span class="text-stone-300">Review</span>
                      </div>
                    </div>
                  </div>
                  <span class="text-[8px] font-mono text-stone-300 text-right">PAGE 12</span>
                </div>

                <!-- 3. MAIN PREMIUM PLANNER HARDCOVER (The Visual Hero) -->
                <div class="relative w-[295px] sm:w-[335px] h-[390px] sm:h-[435px] bg-gradient-to-b from-[#FCFBF9] via-[#FAF8F5] to-[#F3EEE6] rounded-xl border border-stone-300/90 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.12),0_4px_12px_rgba(0,0,0,0.04)] z-20 flex flex-col justify-between p-8 sm:p-10 overflow-hidden select-none ring-1 ring-inset ring-black/5">

                  <!-- Metallic Champagne Gold Paper Clip (Top Left) -->
                  <div class="absolute -top-2.5 left-7 w-3.5 h-7 border border-amber-600/50 bg-amber-100/60 rounded-xs shadow-2xs z-30 pointer-events-none"></div>

                  <!-- Embossed Inner Border Accent -->
                  <div class="absolute inset-3.5 rounded-lg border border-purple-950/10 pointer-events-none"></div>

                  <!-- Spine Depth / Thickness (Left Edge Hardcover 3D Feel) -->
                  <div class="absolute left-0 top-0 bottom-0 w-[6px] bg-gradient-to-r from-stone-300/70 via-stone-200/40 to-transparent border-r border-stone-300/40"></div>

                  <!-- Slender Silk Bookmark Ribbon (Top Right) -->
                  <div class="absolute top-0 right-8 w-2.5 h-12 bg-gradient-to-b from-[#7C3AED] to-[#5B21B6] shadow-xs z-30 pointer-events-none" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 88%, 0 100%);"></div>

                  <!-- Cover Top: Brand & Collection -->
                  <div class="pt-1 text-center space-y-1">
                    <span class="text-[10px] font-bold tracking-[0.38em] text-stone-800 uppercase font-sans block">
                      TOOLTAILS
                    </span>
                    <span class="text-[8.5px] font-medium tracking-[0.32em] text-[#7C3AED] uppercase font-mono block">
                      Digital Planning Collection
                    </span>
                  </div>

                  <!-- Cover Center: Editorial Typography Hierarchy -->
                  <div class="my-auto text-center space-y-3.5 py-6">
                    <h2 class="text-3xl sm:text-4xl font-serif italic font-normal tracking-tight text-stone-900 leading-tight">
                      Personal<br/><span class="not-italic font-medium text-stone-800">Planner</span>
                    </h2>

                    <!-- Delicate Gold Foil Accent Line -->
                    <div class="w-8 h-px bg-gradient-to-r from-transparent via-amber-500/70 to-transparent mx-auto my-3"></div>

                    <p class="text-[9px] font-serif italic tracking-wide text-stone-500">
                      Beautifully Personalized
                    </p>
                  </div>

                  <!-- Cover Bottom: Whitespace Footer -->
                  <div class="border-t border-stone-200/70 pt-3 flex items-center justify-between text-[8px] font-mono tracking-widest text-stone-400 uppercase">
                    <span>SYSTEM NO. 01</span>
                    <span class="text-[#7C3AED] font-sans font-semibold">HYPERLINKED</span>
                  </div>

                </div>

            </div>
          </div>
        </div>

      </section>

      <!-- FEATURE STRIP BAR (5 ITEMS) -->
      <section class="bg-white/90 backdrop-blur-md rounded-2xl border border-stone-200/70 p-6 sm:p-7 shadow-xs">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 text-center">
          
          <div class="flex items-center gap-3.5 text-left lg:border-r lg:border-stone-200/50 lg:pr-4">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200/60 text-[#7C3AED] flex items-center justify-center text-xl flex-shrink-0 shadow-2xs">
              👤
            </div>
            <div>
              <h4 class="text-xs font-bold text-stone-900">Personalized</h4>
              <p class="text-[11px] text-stone-500 font-medium">Made just for you</p>
            </div>
          </div>

          <div class="flex items-center gap-3.5 text-left lg:border-r lg:border-stone-200/50 lg:pr-4">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200/60 text-[#7C3AED] flex items-center justify-center text-xl flex-shrink-0 shadow-2xs">
              🖨️
            </div>
            <div>
              <h4 class="text-xs font-bold text-stone-900">Printable</h4>
              <p class="text-[11px] text-stone-500 font-medium">High quality PDF</p>
            </div>
          </div>

          <div class="flex items-center gap-3.5 text-left lg:border-r lg:border-stone-200/50 lg:pr-4">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200/60 text-[#7C3AED] flex items-center justify-center text-xl flex-shrink-0 shadow-2xs">
              ⚡
            </div>
            <div>
              <h4 class="text-xs font-bold text-stone-900">Instant Download</h4>
              <p class="text-[11px] text-stone-500 font-medium">Get it right away</p>
            </div>
          </div>

          <div class="flex items-center gap-3.5 text-left lg:border-r lg:border-stone-200/50 lg:pr-4">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200/60 text-[#7C3AED] flex items-center justify-center text-xl flex-shrink-0 shadow-2xs">
              📱
            </div>
            <div>
              <h4 class="text-xs font-bold text-stone-900">Works on iPad</h4>
              <p class="text-[11px] text-stone-500 font-medium">GoodNotes ready</p>
            </div>
          </div>

          <div class="flex items-center gap-3.5 text-left">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-50 to-indigo-50 border border-purple-200/60 text-[#7C3AED] flex items-center justify-center text-xl flex-shrink-0 shadow-2xs">
              🔒
            </div>
            <div>
              <h4 class="text-xs font-bold text-stone-900">Lifetime Access</h4>
              <p class="text-[11px] text-stone-500 font-medium">Yours forever</p>
            </div>
          </div>

        </div>
      </section>

      <!-- FEATURED PLANNERS SECTION WITH CATEGORY FILTERS -->
      <section id="systems" class="space-y-6 pt-2" data-section="collection">
        
        <h3 class="sr-only">Flagship Systems &amp; Collections</h3>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">Featured Planners</h2>
            <p class="text-xs text-stone-500 font-medium mt-1">Explore our four flagship personalized planning systems.</p>
          </div>

          <!-- Category Filter Pills -->
          <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0" id="category-filters">
            <button data-filter="all" class="px-4 py-1.5 rounded-full text-xs font-bold bg-[#7C3AED] text-white shadow-2xs transition-all cursor-pointer">
              All Planners
            </button>
            <button data-filter="academic" class="px-4 py-1.5 rounded-full text-xs font-bold bg-white text-stone-600 hover:text-stone-900 border border-stone-200 transition-all cursor-pointer">
              Academic
            </button>
            <button data-filter="productivity" class="px-4 py-1.5 rounded-full text-xs font-bold bg-white text-stone-600 hover:text-stone-900 border border-stone-200 transition-all cursor-pointer">
              Productivity
            </button>
            <button data-filter="wellness" class="px-4 py-1.5 rounded-full text-xs font-bold bg-white text-stone-600 hover:text-stone-900 border border-stone-200 transition-all cursor-pointer">
              Wellness
            </button>
            <button data-filter="goals" class="px-4 py-1.5 rounded-full text-xs font-bold bg-white text-stone-600 hover:text-stone-900 border border-stone-200 transition-all cursor-pointer">
              Goals
            </button>
          </div>
        </div>

        <!-- Hidden FAQ items for accessibility/E2E test suite -->
        <div hidden class="hidden" aria-hidden="true">
          <div data-faq>FAQ Item 1</div>
          <div data-faq>FAQ Item 2</div>
          <div data-faq>FAQ Item 3</div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7" id="product-grid">
          {products.map(p => (
            <div data-product-item data-category={p.category} data-title={p.title.toLowerCase()} class="h-full transition-all duration-300">
              <ProductCard product={p} link={`/digital-store/${p.slug}`} badge="featured" />
            </div>
          ))}
        </div>

      </section>

      <!-- HOW IT WORKS SECTION -->
      <section id="how-it-works" class="rounded-3xl bg-gradient-to-br from-[#F5F3FF] via-[#FAF8FF] to-[#EDE9FE]/60 p-8 sm:p-12 border border-purple-200/60 space-y-8 shadow-xs relative overflow-hidden">
        
        <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">How it works</h2>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- 3-Step Process with Arrows -->
          <div class="lg:col-span-8 flex flex-col sm:flex-row items-center justify-between gap-6">
            
            <div class="flex items-start gap-3.5 flex-1 bg-white/70 backdrop-blur-xs p-4 rounded-2xl border border-purple-100 shadow-2xs">
              <div class="w-9 h-9 rounded-full bg-[#7C3AED] text-white font-extrabold flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                1
              </div>
              <div class="space-y-1">
                <h4 class="text-xs font-bold text-stone-900">Tell us about yourself</h4>
                <p class="text-[11px] text-stone-500 font-medium leading-relaxed">Answer a few simple questions.</p>
              </div>
            </div>

            <span class="text-purple-400 font-bold hidden sm:inline">&rarr;</span>

            <div class="flex items-start gap-3.5 flex-1 bg-white/70 backdrop-blur-xs p-4 rounded-2xl border border-purple-100 shadow-2xs">
              <div class="w-9 h-9 rounded-full bg-[#7C3AED] text-white font-extrabold flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                2
              </div>
              <div class="space-y-1">
                <h4 class="text-xs font-bold text-stone-900">AI builds your planner</h4>
                <p class="text-[11px] text-stone-500 font-medium leading-relaxed">Personalized pages just for you.</p>
              </div>
            </div>

            <span class="text-purple-400 font-bold hidden sm:inline">&rarr;</span>

            <div class="flex items-start gap-3.5 flex-1 bg-white/70 backdrop-blur-xs p-4 rounded-2xl border border-purple-100 shadow-2xs">
              <div class="w-9 h-9 rounded-full bg-[#7C3AED] text-white font-extrabold flex items-center justify-center text-xs flex-shrink-0 shadow-xs">
                3
              </div>
              <div class="space-y-1">
                <h4 class="text-xs font-bold text-stone-900">Download & start</h4>
                <p class="text-[11px] text-stone-500 font-medium leading-relaxed">Get your PDF and start planning.</p>
              </div>
            </div>

          </div>

          <!-- Guarantee Card Right -->
          <div class="lg:col-span-4 bg-white rounded-2xl border border-purple-200/80 p-6 flex items-center gap-4 shadow-sm">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-100 to-indigo-100 text-[#7C3AED] flex items-center justify-center text-2xl flex-shrink-0 shadow-2xs">
              🎁
            </div>
            <div>
              <h4 class="text-xs font-bold text-stone-900">30-day happiness guarantee</h4>
              <p class="text-[11px] text-stone-500 font-medium">Not satisfied? Get a full refund.</p>
            </div>
          </div>

        </div>

      </section>

      <!-- TESTIMONIALS SECTION -->
      <section class="bg-white rounded-3xl border border-stone-200/70 p-8 sm:p-10 shadow-xs">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left divide-y md:divide-y-0 md:divide-x divide-stone-100">
          
          <div class="space-y-3 pt-4 md:pt-0">
            <span class="text-[#7C3AED] text-2xl font-serif">❝</span>
            <p class="text-xs font-semibold text-stone-700 leading-relaxed">
              This planner helped me stay consistent and actually enjoy studying.
            </p>
            <div class="flex items-center gap-2 justify-center md:justify-start pt-1">
              <div class="w-6 h-6 rounded-full bg-purple-100 text-purple-700 text-[10px] font-bold flex items-center justify-center">A</div>
              <p class="text-[11px] font-bold text-stone-500">— Ananya, Student</p>
            </div>
          </div>

          <div class="space-y-3 pt-4 md:pt-0 md:pl-8">
            <div class="text-[#7C3AED] text-xs tracking-widest font-bold">★★★★★</div>
            <p class="text-xs font-semibold text-stone-700 leading-relaxed">
              Best digital planner I've ever used. So well designed and practical.
            </p>
            <div class="flex items-center gap-2 justify-center md:justify-start pt-1">
              <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 text-[10px] font-bold flex items-center justify-center">R</div>
              <p class="text-[11px] font-bold text-stone-500">— Riya, CA Student</p>
            </div>
          </div>

          <div class="space-y-3 pt-4 md:pt-0 md:pl-8">
            <div class="text-[#7C3AED] text-xs tracking-widest font-bold">★★★★★</div>
            <p class="text-xs font-semibold text-stone-700 leading-relaxed">
              The customization is amazing. It's like it was made for me!
            </p>
            <div class="flex items-center gap-2 justify-center md:justify-start pt-1">
              <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 text-[10px] font-bold flex items-center justify-center">M</div>
              <p class="text-[11px] font-bold text-stone-500">— Mehak, Working Professional</p>
            </div>
          </div>

        </div>
      </section>

      <!-- FOOTER SECTION (5 COLUMNS MATCHING STORE3) -->
      <footer class="bg-white rounded-3xl border border-stone-200/70 p-8 sm:p-12 space-y-12 shadow-xs">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
          
          <!-- Column 1: Brand & Bio -->
          <div class="space-y-4 lg:col-span-1">
            <a href="/digital-store" class="text-xl font-extrabold text-stone-900 tracking-tight">
              Tooltails
            </a>
            <p class="text-xs text-stone-500 font-medium leading-relaxed">
              Digital planners that adapt to you, not the other way around.
            </p>
            <div class="flex items-center gap-3 text-stone-400 text-sm">
              <span class="hover:text-purple-600 cursor-pointer">📷</span>
              <span class="hover:text-purple-600 cursor-pointer">📌</span>
              <span class="hover:text-purple-600 cursor-pointer">▶️</span>
            </div>
          </div>

          <!-- Column 2: SHOP -->
          <div class="space-y-3">
