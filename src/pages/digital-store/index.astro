  <!-- Interactive Category Filter Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterButtons = document.querySelectorAll('#category-filters button');
      const productItems = document.querySelectorAll('#product-grid > div');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          filterButtons.forEach(b => {
            b.style.background = 'transparent';
            b.style.color = '#6B7280';
            b.style.border = '1px solid #ede4d8';
          });
          btn.style.background = '#09090b';
          btn.style.color = '#fcf9f2';
          btn.style.border = 'none';

          // Filter product items
          productItems.forEach(item => {
            const cat = item.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              item.style.display = 'block';
              item.style.opacity = '1';
            } else {
              item.style.display = 'none';
              item.style.opacity = '0';
            }
          });
        });
      });
    });

    // ── Hero: rotating planner + name sync ──
    (function() {
      var current = 0;
      var total = 4;
      var interval = 5000;
      var timer;
      var taglines = [
        'Plan your semester',
        'Design your day',
        'Reflect and grow',
        'Reset your focus'
      ];

      function showCard(index) {
        for (var i = 0; i < total; i++) {
          var card = document.getElementById('planner-card-' + i);
          var dot = document.querySelector('[data-planner-dot="' + i + '"]');
          if (i === index) {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0) scale(1)';
            card.style.zIndex = '4';
            dot.style.background = '#2563eb';
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(12px) scale(0.98)';
            card.style.zIndex = '1';
            dot.style.background = '#d4c9bc';
          }
        }
        document.getElementById('planner-tagline').textContent = taglines[index];
        current = index;
      }

      function nextCard() {
        showCard((current + 1) % total);
      }

      // Start rotation
      timer = setInterval(nextCard, interval);

      // Pause on hover
      var stack = document.querySelector('[data-planner-stack]');
      if (stack) {
        stack.addEventListener('mouseenter', function() { clearInterval(timer); });
        stack.addEventListener('mouseleave', function() { timer = setInterval(nextCard, interval); });
      }

      // Dot click handlers
      document.querySelectorAll('[data-planner-dot]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          clearInterval(timer);
          showCard(parseInt(this.getAttribute('data-planner-dot')));
          timer = setInterval(nextCard, interval);
        });
      });


    })();
  </script>
