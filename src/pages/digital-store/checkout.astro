---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Checkout | Tooltails Store"
  description="Complete your order securely with Dodo Payments."
  robots="noindex, nofollow"
>
  <div class="digital-store-root min-h-screen py-10 bg-[var(--ds-bg)]">
    <div class="max-w-[1440px] mx-auto px-4 md:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="max-w-4xl mx-auto mb-8">
        <nav class="flex items-center gap-2 text-xs font-semibold text-stone-400 mb-3 uppercase tracking-wider">
          <a href="/digital-store" class="hover:text-blue-600 transition-colors">Store</a>
          <span>/</span>
          <span class="text-stone-700">Checkout</span>
        </nav>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 font-serif">Secure Order Checkout</h1>
        <p class="text-xs sm:text-sm text-stone-500 font-medium mt-1">
          Complete your order to instantly generate and download your personalized vector PDF planners.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-4xl mx-auto">
        
        <!-- Left Column: Order & Payment -->
        <div class="lg:col-span-7 space-y-6">

          <!-- Email & Secure Payment Card -->
          <div id="checkout-form-container" class="bg-[var(--ds-card)] border border-[var(--ds-border)] rounded-2xl p-6 shadow-2xs space-y-6">

            <!-- Customer Email -->
            <div class="space-y-3">
              <h3 class="text-xs font-bold text-stone-400 uppercase tracking-wider border-b pb-2 flex items-center gap-2" style="border-color:var(--ds-border)">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Delivery Email
              </h3>
              <div>
                <label for="checkout-email" class="block text-xs font-bold text-stone-700 mb-1">Email Address <span class="text-rose-500">*</span></label>
                <input type="email" id="checkout-email" placeholder="you@example.com" autocomplete="email" class="w-full px-3.5 py-2.5 text-sm bg-[var(--ds-card-2)] border border-[var(--ds-border)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[#2563eb]/25 focus:border-[#2563eb] transition-colors text-stone-800 placeholder:text-stone-400 font-medium touch-manipulation shadow-2xs" required />
                <p class="text-[10px] text-stone-400 mt-1 font-medium">Your download links and receipt will be sent here.</p>
                <p id="checkout-email-error" class="text-[10px] text-rose-500 font-medium mt-1 hidden" aria-live="polite"></p>
              </div>
            </div>

            <div class="border-t" style="border-color:var(--ds-border)"></div>

            <!-- Secure Payment via Dodo -->
            <div class="space-y-4">
              <h3 class="text-xs font-bold text-stone-400 uppercase tracking-wider pb-1 flex items-center gap-2">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
                Secure Payment
              </h3>

              <div class="bg-[var(--ds-blue-soft)] border border-[var(--ds-blue-border)] rounded-xl p-4 space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-[var(--ds-card)] border border-[var(--ds-blue-border)] flex items-center justify-center flex-shrink-0 shadow-2xs">
                    <svg class="w-5 h-5 text-[#2563eb]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs font-bold text-stone-800">Powered by Dodo Payments</p>
                    <p class="text-[10px] text-stone-500 font-medium">Your payment info is encrypted and processed securely.</p>
                  </div>
                </div>

                <div class="flex items-center gap-3 text-[10px] text-stone-500 font-medium pt-1 border-t border-[var(--ds-blue-border)]/40">
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    SSL Encrypted
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    PCI Compliant
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    No data stored
                  </span>
                </div>
              </div>
            </div>

            <!-- Pay Button -->
            <button id="checkout-pay-btn" class="w-full py-4 text-xs font-bold text-white bg-[var(--ds-btn)] hover:bg-[var(--ds-btn-hover)] transition-all rounded-full shadow-xs hover:scale-[1.01] active:scale-[0.99] cursor-pointer touch-manipulation flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100">
              <span id="pay-btn-text">Proceed to Secure Checkout</span>
              <span id="pay-btn-spinner" class="hidden">
                <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
              </span>
            </button>

            <div class="flex items-center justify-between text-[10px] text-stone-400 font-medium px-1">
              <span>🔒 Secure checkout via Dodo Payments</span>
              <span>⚡ Instant download after payment</span>
            </div>
          </div>

        </div>

        <!-- Right Column: Order Summary -->
        <div class="lg:col-span-5">
          <div class="bg-[var(--ds-card)] border border-[var(--ds-border)] rounded-2xl p-5 shadow-2xs space-y-4">
            <h2 class="text-xs font-bold text-stone-400 uppercase tracking-wider border-b pb-2 flex items-center gap-2" style="border-color:var(--ds-border)">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
              Order Summary
            </h2>
            
            <div id="summary-items" class="space-y-3 max-h-[280px] overflow-y-auto pr-1">
              <!-- Dynamically populated items -->
            </div>

            <div class="border-t pt-4 space-y-2 text-xs" style="border-color:var(--ds-border)">
              <div class="flex items-center justify-between text-stone-500 font-medium">
                <span>Subtotal</span>
                <span id="summary-subtotal">$0.00</span>
              </div>
              <div class="flex items-center justify-between text-stone-500 font-medium">
                <span>Personalization</span>
                <span class="text-[#2563eb] font-bold">Included Free</span>
              </div>
              <div class="flex items-center justify-between text-sm font-bold text-stone-900 pt-2 border-t" style="border-color:var(--ds-border)">
                <span>Total</span>
                <span id="summary-total" class="text-[var(--ds-text)] font-bold">$0.00</span>
              </div>
            </div>

            <!-- Trust Badges -->
            <div class="pt-4 border-t space-y-2 text-[10px] text-stone-500 font-medium" style="border-color:var(--ds-border)">
              <div class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span> 30-Day Money Back Guarantee
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span> Free Unlimited Regenerations for 30 Days
              </div>
              <div class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span> Instant PDF Download
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="checkout-page-toast" class="fixed bottom-6 right-6 px-4 py-3 bg-stone-900 border border-stone-800 text-white text-xs font-bold rounded-xl shadow-xl translate-y-4 opacity-0 transition-all duration-300 pointer-events-none z-50" aria-live="polite" role="status">
    Notification message
  </div>
</Layout>

<style>
  .digital-store-root {
    color: var(--ds-text);
    background: var(--ds-bg);
  }
</style>

<script>
  import { formatAmount } from '../../scripts/currency';
  import type { CurrencyCode } from '../../data/pricing';

  const payBtn = document.getElementById('checkout-pay-btn') as HTMLButtonElement;
  const payBtnText = document.getElementById('pay-btn-text');
  const payBtnSpinner = document.getElementById('pay-btn-spinner');
  const checkoutEmail = document.getElementById('checkout-email') as HTMLInputElement;
  const emailError = document.getElementById('checkout-email-error');
  const summaryItems = document.getElementById('summary-items');
  const summarySubtotal = document.getElementById('summary-subtotal');
  const summaryTotal = document.getElementById('summary-total');
  const toast = document.getElementById('checkout-page-toast');

  interface CartItem {
    id: string;
    title: string;
    slug: string;
    price: number;
    icon: string;
    quantity: number;
    productId?: string;
    currency?: string;
    personalization?: Record<string, string>;
  }

  let cartItems: CartItem[] = [];

  function itemCurrency(item: CartItem): CurrencyCode {
    return item.currency === 'INR' ? 'INR' : 'USD';
  }

  function loadCart() {
    try {
      const stored = localStorage.getItem('tt_cart');
      cartItems = stored ? JSON.parse(stored) : [];
    } catch {
      cartItems = [];
    }
  }

  function showToast(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.remove('translate-y-4', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    clearTimeout((toast as any)._hideTimer);
    (toast as any)._hideTimer = setTimeout(() => {
      toast.classList.add('translate-y-4', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 3000);
  }

  function validateEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function renderSummary() {
    loadCart();
    if (!summaryItems || !summarySubtotal || !summaryTotal) return;

    if (cartItems.length === 0) {
      summaryItems.innerHTML = `<div class="text-xs text-stone-400 font-medium py-4 text-center">Your cart is empty. <a href="/digital-store" class="text-[#2563eb] underline">Browse planners</a></div>`;
      summarySubtotal.textContent = formatAmount(0, 'USD');
      summaryTotal.textContent = formatAmount(0, 'USD');
      return;
    }

    let subtotal = 0;
    const currency = itemCurrency(cartItems[0]);
    summaryItems.innerHTML = cartItems.map(item => {
      const price = Number(item.price) || 0;
      subtotal += price;
      return `
        <div class="flex items-center justify-between p-2.5 rounded-xl border border-[var(--ds-border)] text-xs" style="background:var(--ds-bg-soft)">
          <div class="flex items-center gap-2">
            <span class="text-base" aria-hidden="true">${item.icon || '\uD83D\uDCC4'}</span>
            <div>
              <div class="font-bold text-stone-800 line-clamp-1">${item.title}</div>
              <div class="text-[10px] text-stone-400">Personalized PDF</div>
            </div>
          </div>
          <span class="font-bold text-stone-900">${formatAmount(price, itemCurrency(item))}</span>
        </div>
      `;
    }).join('');

    summarySubtotal.textContent = formatAmount(subtotal, currency);
    summaryTotal.textContent = formatAmount(subtotal, currency);
  }

  renderSummary();

  if (payBtn) {
    payBtn.addEventListener('click', async () => {
      const email = checkoutEmail ? checkoutEmail.value.trim() : '';

      if (emailError) emailError.classList.add('hidden');
      if (!email || !validateEmail(email)) {
        if (emailError) {
          emailError.textContent = email ? 'Please enter a valid email address' : 'Email address is required';
          emailError.classList.remove('hidden');
        }
        showToast(email ? 'Please enter a valid email address' : 'Please enter your delivery email address');
        checkoutEmail?.focus();
        return;
      }

      loadCart();
      if (cartItems.length === 0) {
        showToast('Your cart is empty');
        return;
      }

      payBtn.disabled = true;
      if (payBtnText) payBtnText.textContent = 'Preparing secure checkout...';
      if (payBtnSpinner) payBtnSpinner.classList.remove('hidden');

      try {
        const item = cartItems[0];
        const productId = item.productId || item.id || item.slug;

        const resp = await fetch('/api/create-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId,
            productTitle: item.title,
            productSlug: item.slug,
            price: item.price,
            icon: item.icon,
            quantity: item.quantity || 1,
            currency: itemCurrency(item),
            customerEmail: email,
            customerName: email.split('@')[0],
            personalization: item.personalization || {},
          }),
        });

        const data = await resp.json();

        if (!resp.ok) {
          throw new Error(data.error || 'Failed to create checkout');
        }

        localStorage.removeItem('tt_cart');
        window.location.href = data.checkoutUrl;
      } catch (err: any) {
        console.error('Checkout error:', err);
        showToast(err.message || 'Something went wrong. Please try again.');
        payBtn.disabled = false;
        if (payBtnText) payBtnText.textContent = 'Proceed to Secure Checkout';
        if (payBtnSpinner) payBtnSpinner.classList.add('hidden');
      }
    });
  }
</script>
