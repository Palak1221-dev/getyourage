  "wellness-journal": {
    features: [
      { icon: '🌿', title: 'Habit Streak Grid', description: 'Six daily habits on a continuous monthly grid. Watch your consistency grow one day at a time.' },
      { icon: '📊', title: 'Mood & Energy Logger', description: 'Log how you feel each day. After a month, patterns emerge — you will see what lifts you and what drains you.' },
      { icon: '🌅', title: 'Morning Check-in', description: 'Set an intention, plan hydration, and choose a movement goal before the day pulls you in every direction.' },
      { icon: '🌙', title: 'Evening Reflection', description: 'End your day with three gratitudes, one lesson learned, and a quiet wind-down plan.' },
      { icon: '🧘', title: 'Self-Care Planner', description: 'Weekly self-care planned like you plan work — thoughtfully, intentionally, without guilt.' },
      { icon: '📋', title: 'Monthly Review', description: 'A full-page review of your mood trends, habit consistency, and energy patterns. Progress over perfection.' }
    ],
    faqs: [
      { q: 'How much time does daily logging take?', a: 'About 5 minutes in the morning and 5 minutes before sleep. Designed to be sustainable — not a second job.' },
      { q: 'What modules are included?', a: 'Habit streak grid (6 habits), mood & energy logger, morning check-in, evening gratitude, self-care planner, and monthly wellness review. Every page connects.' },
      { q: 'Is there a live web app?', a: 'Yes. After purchase you get access to the full interactive app at /app/wellness-journal. Start logging habits and mood directly in your browser on any device.' }
    ],
    storyTitle: 'Wellness happens in the small moments you choose yourself.',
    storyText: 'Most wellness journals focus on measurement — track this, log that, optimize everything. But wellness is not a data problem. It is an attention problem.',
