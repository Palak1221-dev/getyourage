      { icon: '✏️', title: 'Assignment Planner', description: 'Big projects break into milestones. Each milestone has a checkbox, a due date, and a place in your weekly spread.' },
      { icon: '📊', title: 'Study Analytics', description: 'Hours logged, reading velocity, preparation score — calculated from your entries. No manual formulas.' },
      { icon: '📄', title: 'Print-Ready Export', description: 'Vector-perfect PDF in A4 and US Letter. Opens in any reader or GoodNotes.' }
