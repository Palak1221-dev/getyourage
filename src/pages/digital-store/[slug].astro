---
import Layout from "../../layouts/Layout.astro";
import ProductPage from "../../components/digital-store/ProductPage.astro";

import { products, productAliases } from "../../data/products";

export const prerender = true;

export function getStaticPaths() {
  const mainPaths = products.map(product => ({
    params: { slug: product.slug },
    props: { product }
  }));

  const aliasPaths = Object.entries(productAliases).map(([alias, targetSlug]) => {
    const targetProduct = products.find(p => p.slug === targetSlug) || products[0];
    return {
      params: { slug: alias },
      props: { product: { ...targetProduct, slug: alias } }
    };
  });

  return [...mainPaths, ...aliasPaths];
}

const slug = Astro.params.slug || '';
const resolvedSlug = productAliases[slug] || slug;
const resolvedProduct = products.find(p => p.slug === resolvedSlug);
const product = Astro.props.product || (resolvedProduct ? { ...resolvedProduct, slug } : products[0]);

const slugExtraData: Record<string, {
  features: { icon: string; title: string; description: string }[];
  faqs: { q: string; a: string }[];
  storyTitle: string;
  storyText: string;
  storyText2?: string;
  whoFor?: string;
  journeyLabel?: string;
  journeyDesc?: string;
}> = {
  "study-planner-pro": {
    features: [
      { icon: '📅', title: 'Semester Overview', description: 'Your entire term on a single spread. Every subject, deadline, and exam mapped so you see the full picture before the first class begins.' },
