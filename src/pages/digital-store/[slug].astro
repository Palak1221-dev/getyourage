    whoFor: 'For anyone who has tried to build habits before and wants a gentler, more sustainable approach to wellness.'
  },
  "social-media-detox": {
    features: [
      { icon: '📊', title: 'Digital Audit', description: 'Face your baseline without judgment. Screen time, unlocks, peak hours, and triggers — know where you stand.' },
      { icon: '🎯', title: 'Detox Plan', description: 'Set boundaries that fit your life. Choose offline activities, define app limits, design your new normal.' },
      { icon: '📱', title: 'Daily Tracker', description: 'Log screen time, phone-free hours, and how you spent your reclaimed time. Simple, honest, daily.' },
      { icon: '🧠', title: 'Cravings Log', description: 'Recognize the urge before it controls you. Identify triggers. Practice healthier responses.' },
      { icon: '📈', title: 'Progress Review', description: 'See your screen time trend week over week. Celebrate what is working, adjust what is not.' },
      { icon: '🌿', title: 'Replacement Activities', description: 'A curated catalog of offline things you actually want to do — read, walk, create, connect.' }
    ],
    faqs: [
      { q: 'How long does the detox take?', a: 'The planner supports a 4-week journey with daily tracking and weekly reflections. Most people see meaningful change in 30 days.' },
      { q: 'What modules are included?', a: 'Digital audit, personalized detox plan, daily screen time tracker, cravings & triggers log, replacement activities catalog, and weekly progress reviews.' },
      { q: 'Is there a live web app?', a: 'Yes. After purchase you get access to the full interactive app at /app/social-media-detox. Track screen time, log cravings, and review progress in your browser on any device.' }
    ],
    storyTitle: 'You did not lose your focus. Your phone just got better at stealing it.',
    storyText: 'Social Media Detox was created for people who know they spend too much time on their phone but do not know how to change it. Not through shame or restriction — through awareness and intention.',
    storyText2: 'Start with a digital audit that shows your baseline without judgment. Design boundaries that fit your actual life, not an idealized version of it. Track daily in a way that feels honest, not punishing. See your progress week after week. The goal is not to quit technology. It is to use it on your terms.',
    whoFor: 'For anyone who has tried to cut back on screen time and wants a structured, judgment-free approach that actually works.'
  }
};

const extra = slugExtraData[product.slug] || {
  features: [],
  faqs: [{ q: 'What is included in the download?', a: 'Includes vector PDF (A4 + US Letter) files.' }],
  storyTitle: `Master your goals with ${product.title}.`,
  storyText: product.longDescription.split('. ').slice(0, 2).join('. ') + '.'
};
---

<Layout title={`${product.title} — Personalized System | Tooltails`} description={product.description} image={product.ogImage || '/og-image.png'}>
  <ProductPage
    product={product}
    features={extra.features}
    faqs={extra.faqs}
    heroTagline={product.tagline}
    storyTitle={extra.storyTitle}
    storyText={extra.storyText}
    storyText2={extra.storyText2}
    whoFor={extra.whoFor}
    webAppSlug={resolvedSlug}
  />
</Layout>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    .digital-store-root * {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
