---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Payment Cancelled — Tooltails Store"
  description="Your payment was cancelled."
  robots="noindex, nofollow"
>
  <div class="min-h-screen bg-[#FAF9FC] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg mx-auto text-center space-y-8">

      <div class="w-20 h-20 bg-stone-50 border-2 border-stone-200 rounded-full flex items-center justify-center text-4xl mx-auto shadow-lg">
        <svg class="w-10 h-10 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 font-serif tracking-tight">
          Payment Cancelled
        </h1>
        <p class="text-sm text-stone-500 font-medium max-w-md mx-auto">
          You closed the payment window. No charges were made.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/digital-store/checkout" class="px-8 py-4 rounded-full bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-bold text-sm shadow-lg shadow-purple-600/20 hover:shadow-2xl transition-all flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
          Resume Checkout
        </a>
        <a href="/digital-store" class="px-8 py-4 rounded-full bg-white hover:bg-stone-50 text-stone-700 border border-stone-200 font-bold text-sm transition-all flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M3 12h18M12 3l9 9-9 9"/>
          </svg>
          Continue Shopping
        </a>
      </div>

      <p class="text-xs text-stone-400 font-medium">
        Changed your mind? <a href="/digital-store" class="text-[#7C3AED] font-bold hover:underline">Browse all planners</a>
      </p>

    </div>
  </div>
</Layout>
