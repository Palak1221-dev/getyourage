---
import Layout from "../layouts/Layout.astro";
import FutureAgeCalculator from "../components/calculators/FutureAgeCalculator.astro";
import FAQ from "../components/ui/FAQ.astro";
import HowToUseModal from "../components/ui/HowToUseModal.astro";

const howToUseSteps = [
  {
    title: "Enter Birth Date",
    description: "Provide your birth day, month, and four-digit year."
  },
  {
    title: "Enter Future Date",
    description: "Choose any future date (such as a career milestone, retirement target, or upcoming year)."
  },
  {
    title: "Calculate Future Age",
    description: "Click \"Calculate Future Age\" to see your exact age on that date, the weekday it falls on, and the total days remaining until then."
  }
];
const howToUseTip = "Ideal for retirement planning, milestone anniversaries, and long-term goal setting.";

const faqItems = [
  {
    question: "How does a future age calculator work?",
    answer: "It calculates the exact time difference between your date of birth and any specific future date you provide, accounting for leap years and different month lengths."
  },
  {
    question: "Can I calculate my age in 2030?",
    answer: "Yes, simply enter your birth date and set the future date to any day in the year 2030 to see exactly how old you will be."
  },
  {
    question: "Is leap year handled correctly?",
    answer: "Absolutely. Our advanced date algorithms perfectly account for leap years, ensuring your calculated future age is mathematically accurate."
  },
  {
    question: "Can I calculate age on a specific date?",
    answer: "Yes, you can select any exact day, month, and year in the future (or past, as long as it's after your birth date) to find your precise age on that day."
  },
  {
    question: "Is my data private?",
    answer: "Yes. All calculation processing runs locally in your browser. No birth date or target date details leave your device."
  }
];

const canonicalUrl = "https://tooltails.com/future-age/";
---

<Layout 
  title="Future Age Calculator — Calculate Your Age on Any Future Date" 
  description="Find out exactly how old you will be on any future date. Calculate future age in years, months, weeks, and days."
>
  <!-- Hero Section -->
  <section class="px-4 sm:px-6 pt-4 pb-2">
    <div class="max-w-7xl mx-auto flex flex-col gap-3">
      <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink mb-1.5 leading-tight">
            Future Age Calculator — Calculate Your Age on Any Future Date
          </h1>
          <p class="text-body text-sm max-w-2xl leading-relaxed">
            Find out exactly how old you will be on any future date. Calculate future age in years, months, weeks, and days.
          </p>
        </div>
        <div class="shrink-0 self-start sm:self-auto">
          <HowToUseModal toolName="Future Age Calculator" steps={howToUseSteps} tip={howToUseTip} />
        </div>
      </div>

      <div class="w-full">
        <FutureAgeCalculator />
      </div>

      <!-- Trust Signals -->
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 mt-6 text-[11px] font-bold text-mute uppercase tracking-widest">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-link"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Privacy First (Client-Side)
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-link"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          Calendar Accurate
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-link"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
          100% Free
        </span>
      </div>
    </div>
  </section>

  <!-- Comprehensive Explanatory Section -->
  <section class="px-4 sm:px-6 py-12 bg-canvas border-t border-hairline">
    <div class="max-w-7xl mx-auto space-y-12">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">How Future Age Calculation Works</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <p class="text-body leading-relaxed text-base mb-4 max-w-3xl">
          Projecting your age to an upcoming date requires calculating the exact chronological interval between your date of birth and a future target date. Rather than approximating with a fixed 365-day year, the algorithm uses forward calendar arithmetic to determine completed full years, full months, and remaining days while honoring every leap year and differing month length.
        </p>
        <p class="text-body leading-relaxed text-base max-w-3xl">
          Whether you are determining how old you will be when a child graduates, setting career goals, or projecting retirement eligibility, our tool delivers instantaneous mathematical accuracy. To evaluate your current age relative to today, try our companion <a href="/age-calculator/" class="text-link font-medium hover:underline">exact age calculator</a>, or see how much time remains until your next celebration with the <a href="/birthday-countdown/" class="text-link font-medium hover:underline">birthday countdown tool</a>.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-7 h-7 rounded-full bg-link/10 text-link flex items-center justify-center shadow-inner text-xs font-bold">1</div>
            <h3 class="text-base font-bold text-ink group-hover:text-link transition-colors">Calendar Borrowing & Carry-Forward</h3>
          </div>
          <p class="text-sm text-body leading-relaxed">
            When projecting future age, the target date serves as the minuend and your birth date acts as the subtrahend. If the future day or month is numerically lower than your birth day or month, the calculator accurately borrows days from the preceding target month and carries forward 12 calendar months from the target year.
          </p>
        </div>
        <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-7 h-7 rounded-full bg-link/10 text-link flex items-center justify-center shadow-inner text-xs font-bold">2</div>
            <h3 class="text-base font-bold text-ink group-hover:text-link transition-colors">Future Weekday Forecasting</h3>
          </div>
          <p class="text-sm text-body leading-relaxed">
            Our tool also reveals which day of the week your target date will land on. This makes it effortless to plan milestone retirement parties, anniversary trips, or graduation celebrations that fall specifically on weekends.
          </p>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Retirement & Financial Planning Horizons</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <h3 class="text-base font-bold text-ink mb-2 group-hover:text-link transition-colors">Age 59½ (Penalty-Free IRA)</h3>
            <p class="text-sm text-body leading-relaxed">
              In the United States, reaching age 59 and 6 calendar months allows you to withdraw from traditional IRAs and 401(k) plans without incurring the 10% early withdrawal tax penalty.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <h3 class="text-base font-bold text-ink mb-2 group-hover:text-link transition-colors">Age 65 (Medicare Enrollment)</h3>
            <p class="text-sm text-body leading-relaxed">
              Medicare eligibility begins at age 65. The Initial Enrollment Period (IEP) spans a 7-month window starting 3 months before your 65th birth month.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <h3 class="text-base font-bold text-ink mb-2 group-hover:text-link transition-colors">Full Retirement Age (66–67)</h3>
            <p class="text-sm text-body leading-relaxed">
              Depending on your birth year, Social Security Full Retirement Age occurs between 66 and 67. Projecting this date determines when you can claim 100% benefits.
            </p>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Life in Days Milestones</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <h3 class="font-bold text-ink mb-2 text-base group-hover:text-link transition-colors">The 10,000th Day of Life</h3>
            <p class="text-sm text-body leading-relaxed">
              Reaching 10,000 days of life occurs at approximately <strong>27 years, 4 months, and 15 days</strong> (accounting for 6 to 7 leap years). It represents a unique young adulthood milestone between ages 25 and 30.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <h3 class="font-bold text-ink mb-2 text-base group-hover:text-link transition-colors">The 20,000th Day of Life</h3>
            <p class="text-sm text-body leading-relaxed">
              Your 20,000th day occurs at approximately <strong>54 years, 9 months, and 5 days</strong>. Many people celebrate this unique milestone as a celebratory halfway point toward their centennial year.
            </p>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Key Statutory Milestone Ages</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <div class="bg-canvas border border-hairline rounded-3xl overflow-hidden shadow-sm">
          <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-canvas-soft border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-4 sm:p-5 text-xs font-extrabold uppercase tracking-wider text-mute">Target Age</th>
                <th class="p-4 sm:p-5 text-xs font-extrabold uppercase tracking-wider text-mute">Legal & Regulatory Milestone</th>
                <th class="p-4 sm:p-5 text-xs font-extrabold uppercase tracking-wider text-mute">Primary Planning Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline text-body">
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Age 50</td>
                <td class="p-4 sm:p-5">Catch-up retirement contribution eligibility</td>
                <td class="p-4 sm:p-5">Increase annual contribution limits to 401(k) and IRA accounts</td>
              </tr>
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Age 59½</td>
                <td class="p-4 sm:p-5">Penalty-free retirement distributions</td>
                <td class="p-4 sm:p-5">Review early retirement drawdowns without 10% tax penalty</td>
              </tr>
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Age 62</td>
                <td class="p-4 sm:p-5">Early Social Security claim eligibility (reduced benefits)</td>
                <td class="p-4 sm:p-5">Weigh immediate reduced income against waiting for Full Retirement Age</td>
              </tr>
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Age 65</td>
                <td class="p-4 sm:p-5">Medicare healthcare coverage begins</td>
                <td class="p-4 sm:p-5">Enroll in Medicare Part A and Part B during Initial Enrollment Period</td>
              </tr>
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Age 70</td>
                <td class="p-4 sm:p-5">Maximum delayed retirement credits (Social Security)</td>
                <td class="p-4 sm:p-5">Claim peak benefit payout (delayed credits stop accumulating at 70)</td>
              </tr>
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Age 73–75</td>
                <td class="p-4 sm:p-5">Required Minimum Distributions (RMDs)</td>
                <td class="p-4 sm:p-5">Begin mandatory minimum withdrawals from qualified retirement plans</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="px-4 sm:px-6 py-12 bg-canvas border-b border-hairline">
    <div class="max-w-7xl mx-auto text-center">
      <div class="flex items-center gap-3 mb-8">
        <div class="h-px w-full bg-hairline"></div>
        <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Explore Companion Tools</h3>
        <div class="h-px w-full bg-hairline"></div>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/age-calculator/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Exact Age Calculator
        </a>
        <a href="/age-difference/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Age Difference Calculator
        </a>
        <a href="/birthday-countdown/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Birthday Countdown
        </a>
        <a href="/duration/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Date Duration Calculator
        </a>
        <a href="/word-counter/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Word Counter
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="px-4 sm:px-6 py-16">
    <div class="max-w-4xl mx-auto">
      <FAQ items={faqItems} renderSchema={false} />
    </div>
  </section>

  <!-- Structured Data (Unified Graph) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Tooltails", "item": "https://tooltails.com/" },
          { "@type": "ListItem", "position": 2, "name": "Future Age Calculator", "item": canonicalUrl }
        ]
      },
      {
        "@type": "WebApplication",
        "name": "Future Age Calculator",
        "url": canonicalUrl,
        "description": "Find out exactly how old you will be on any future date.",
        "applicationCategory": "UtilityApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ]
  })} />
</Layout>

