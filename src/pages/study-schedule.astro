          const rowH = 15;
          let rowCount = Math.floor(remaining / rowH);
          rowCount = Math.max(5, Math.min(rowCount, 8));
          let html = '';
          for (let i = 0; i < rowCount; i++) {
            html += '<div style="display: flex; align-items: center; gap: 2px;"><span style="font-size: 7px; color: #94a3b8; flex-shrink: 0;">☐</span><div style="flex: 1; border-bottom: 1px dashed #94a3b8; height: 9px;"></div></div>';
