  .missed-slider { -webkit-appearance: none; appearance: none; height: 6px; border-radius: 3px; background: var(--color-hairline); outline: none; }
  .missed-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%; background: var(--color-link, #2563eb); cursor: pointer; border: 2px solid white; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
  .missed-slider::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: var(--color-link, #2563eb); cursor: pointer; border: 2px solid white; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
  .day-off-btn.active { background: #7c3aed !important; color: white !important; border-color: #7c3aed !important; }
