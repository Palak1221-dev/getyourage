---
import { verifyAccessToken, accessCookieName } from "../../lib/access";

const slug = 'study-planner-pro';
const token = Astro.cookies.get(accessCookieName(slug))?.value;
const accessGranted = !!token && verifyAccessToken(token, slug);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Study Planner Pro — Tooltails</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400..800&family=Playfair+Display:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    html,body{width:100%;height:100%;overflow:hidden;font-family:'Outfit',Inter,sans-serif;background:#f5f2ed;color:#374151}
    #app-container{width:100%;height:100%;overflow:hidden;transition:filter 0.4s ease}
    #app-container.gated{filter:blur(10px);pointer-events:none;user-select:none}
    #purchase-gate{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;background:rgba(30,25,20,0.45);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
    #purchase-gate.show{display:flex}
    .gate-card{background:#fffcf5;border-radius:24px;padding:40px 44px;max-width:440px;width:90%;text-align:center;box-shadow:0 32px 64px -16px rgba(0,0,0,0.25);border:1px solid #ede4d8;animation:gateIn 0.4s cubic-bezier(0.16,1,0.3,1)}
    @keyframes gateIn{from{opacity:0;transform:scale(0.92) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)}}
    .gate-card .app-icon{font-size:40px;margin-bottom:8px}
    .gate-card h1{font-size:20px;font-weight:800;color:#1F2937;font-family:'Playfair Display',Outfit,serif;margin-bottom:4px}
    .gate-card .sub{font-size:11px;color:#6B7280;font-weight:500;margin-bottom:16px}
    .gate-card .desc{font-size:10px;color:#6B7280;line-height:1.6;font-weight:500;margin-bottom:20px}
    .gate-card .features{display:flex;flex-direction:column;gap:6px;margin-bottom:20px;text-align:left}
    .gate-card .features span{font-size:10px;color:#4B5563;font-weight:500;display:flex;align-items:center;gap:6px}
    .gate-card .features span::before{content:'✓';color:#059669;font-weight:800;font-size:11px}
    .gate-btn{display:inline-flex;align-items:center;gap:6px;padding:12px 28px;border-radius:60px;font-size:12px;font-weight:700;border:none;cursor:pointer;text-decoration:none;transition:all 0.15s}
    .gate-btn.primary{background:#7c3aed;color:#fff;box-shadow:0 4px 16px rgba(124,58,237,0.25)}
    .gate-btn.primary:hover{background:#6d28d9;transform:translateY(-1px);box-shadow:0 6px 24px rgba(124,58,237,0.3)}
    .gate-btn.secondary{background:transparent;color:#6B7280;font-size:10px;font-weight:600;padding:8px 16px}
    .gate-btn.secondary:hover{color:#374151}
    .gate-divider{height:1px;background:#ede4d8;margin:16px 0}
    .gate-footer{font-size:9px;color:#9CA3AF;font-weight:500}
    .gate-footer a{color:#7c3aed;font-weight:700;text-decoration:none}
    .gate-footer a:hover{text-decoration:underline}
    .price-tag{font-size:28px;font-weight:900;color:#1F2937;letter-spacing:-0.02em}
    .price-tag small{font-size:12px;font-weight:500;color:#6B7280}
    .saved-badge{position:fixed;bottom:24px;right:24px;z-index:10000;background:#059669;color:#fff;font-size:9px;font-weight:700;padding:6px 14px;border-radius:20px;box-shadow:0 2px 12px rgba(5,150,105,0.25);opacity:0;transition:opacity 0.3s;pointer-events:none}
    .saved-badge.show{opacity:1}
    .dp-toolbar .dp-nav-label{color:#6b5f51!important}
  </style>
</head>
<body data-access={accessGranted ? 'granted' : 'denied'}>
  <div id="app-container"></div>

  <div id="purchase-gate">
    <div class="gate-card">
      <div class="app-icon">📅</div>
      <h1>Study Planner Pro</h1>
      <p class="sub">Your Complete Academic Command Center</p>
      <p class="desc">A full semester system with revision tracking, assignment planning, exam countdowns, study schedules, lecture notes, and analytics — all in one live web app.</p>
      <div class="features">
        <span>Semester Overview with your name, term, and subjects</span>
        <span>12-Week Weekly Planner Spreads with priority zones</span>
        <span>3-Pass Revision Tracker across all subjects</span>
        <span>Assignment Breakdown Engine with milestone checklists</span>
        <span>Exam Countdown Dashboard with weak-topic matrix</span>
        <span>Study Analytics with hours logged and readiness score</span>
      </div>
      <div style="margin-bottom:16px">
        <span class="price-tag"><span data-price data-usd="19.99" data-inr="799">$19.99</span> <small>one-time</small></span>
        <div style="font-size:9px;color:#059669;font-weight:700;margin-top:4px">✓ 30-day money-back guarantee</div>
      </div>
      <a href="/digital-store/study-planner-pro#customize" class="gate-btn primary">Get Instant Access →</a>
      <div class="gate-divider"></div>
      <p class="gate-footer">Already purchased? <a href="#" id="unlock-btn">Click here to unlock</a></p>
      <div id="unlock-form" style="display:none;margin-top:14px;text-align:left">
        <input id="unlock-email" type="email" placeholder="Enter the email you paid with" style="width:100%;padding:10px 14px;border:1px solid #ede4d8;border-radius:10px;font-size:11px;background:#fff;color:#1F2937;box-sizing:border-box;outline:none;font-family:inherit" />
        <button id="unlock-submit" class="gate-btn primary" style="width:100%;justify-content:center;margin-top:10px">Verify Purchase</button>
        <div id="unlock-msg" style="font-size:10px;color:#b91c1c;font-weight:600;margin-top:8px;display:none"></div>
      </div>
      <div style="margin-top:8px">
        <button class="gate-btn secondary" id="preview-btn">Show me a preview first</button>
      </div>
    </div>
  </div>

  <div class="saved-badge" id="saved-badge">✓ Saved</div>

  <script>
  import { DigitalPlanner } from "../../scripts/planner-engine/digital-planner";
  import { getTheme } from "../../scripts/planner-engine/preview-renderer";
  import { setupCurrencyEngine } from "../../scripts/currency";

  setupCurrencyEngine();

  (function(){
    const SLUG = 'study-planner-pro';
    const ACCESS = document.body.dataset.access === 'granted';

    var container = document.getElementById('app-container');
    var gate = document.getElementById('purchase-gate');

    function initApp() {
      if (container.__dp_mounted) return;
      container.__dp_mounted = true;

      const dp = new DigitalPlanner(
        container,
        {},
        getTheme('violet'),
        'Study Planner Pro',
        '📅',
        { sidebar: true, previewOnly: !ACCESS }
      );
      dp.mount();

      setTimeout(function() {
        var title = container.querySelector('.digital-planner-sidebar-title');
        if (title) title.innerHTML = '📅 Study Planner Pro';
      }, 0);
    }

    if (ACCESS) {
      gate.classList.remove('show');
      gate.style.display = 'none';
      initApp();
    } else {
      gate.classList.add('show');
      initApp();
      container.classList.add('gated');
    }

    var unlockForm = document.getElementById('unlock-form');
    document.getElementById('unlock-btn').addEventListener('click', function(e) {
      e.preventDefault();
      if (unlockForm) unlockForm.style.display = 'block';
    });

    var unlockSubmit = document.getElementById('unlock-submit');
    if (unlockSubmit) unlockSubmit.addEventListener('click', async function() {
      var emailEl = document.getElementById('unlock-email') as HTMLInputElement;
      var msgEl = document.getElementById('unlock-msg');
      var email = emailEl ? emailEl.value.trim() : '';
      if (!email || !email.includes('@')) {
        if (msgEl) { msgEl.textContent = 'Please enter a valid email address.'; msgEl.style.display = 'block'; }
        return;
      }
      unlockSubmit.disabled = true;
      unlockSubmit.textContent = 'Verifying…';
      if (msgEl) msgEl.style.display = 'none';
      try {
        var resp = await fetch('/api/access/unlock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, slug: SLUG })
        });
        var data = await resp.json();
        if (resp.ok && data.unlocked) {
          window.location.reload();
          return;
        }
        if (msgEl) { msgEl.textContent = data.error || 'No purchase found for this email.'; msgEl.style.display = 'block'; }
      } catch (err) {
        if (msgEl) { msgEl.textContent = 'Something went wrong. Please try again.'; msgEl.style.display = 'block'; }
      }
      unlockSubmit.disabled = false;
      unlockSubmit.textContent = 'Verify Purchase';
    });

    var previewActive = false;
    document.getElementById('preview-btn').addEventListener('click', function() {
      if (!previewActive) {
        gate.style.display = 'none';
        container.classList.remove('gated');
        previewActive = true;
        this.textContent = 'Back to purchase';
      } else {
        gate.style.display = 'flex';
        container.classList.add('gated');
        previewActive = false;
        this.textContent = 'Show me a preview first';
      }
    });
  })();
  </script>
</body>
</html>
