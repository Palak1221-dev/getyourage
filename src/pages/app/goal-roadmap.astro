<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Goal Roadmap — Tooltails</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400..800&family=Playfair+Display:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    html,body{width:100%;height:100%;overflow:hidden;font-family:'Outfit',Inter,sans-serif;background:#f5f2ed;color:#374151}
    #app-container{width:100%;height:100%;overflow:hidden;transition:filter 0.4s ease}
    #app-container.gated{filter:blur(10px);pointer-events:none;user-select:none}
    #purchase-gate{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;background:rgba(30,25,20,0.45);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
    #purchase-gate.show{display:flex}
    .gate-card{background:#fffcf5;border-radius:24px;padding:40px 44px;max-width:440px;width:90%;text-align:center;box-shadow:0 32px 64px -16px rgba(0,0,0,0.25);border:1px solid #ede4d8;animation:gateIn 0.4s cubic-bezier(0.16,1,0.3,1)}
    @keyframes gateIn{from{opacity:0;transform:scale(0.92) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)}}
    .gate-card .app-icon{font-size:40px;margin-bottom:8px}
    .gate-card h1{font-size:20px;font-weight:800;color:#1F2937;font-family:'Playfair Display',Outfit,serif;margin-bottom:4px}
    .gate-card .sub{font-size:11px;color:#6B7280;font-weight:500;margin-bottom:16px}
    .gate-card .desc{font-size:10px;color:#6B7280;line-height:1.6;font-weight:500;margin-bottom:20px}
    .gate-card .features{display:flex;flex-direction:column;gap:6px;margin-bottom:20px;text-align:left}
    .gate-card .features span{font-size:10px;color:#4B5563;font-weight:500;display:flex;align-items:center;gap:6px}
    .gate-card .features span::before{content:'✓';color:#059669;font-weight:800;font-size:11px}
    .gate-btn{display:inline-flex;align-items:center;gap:6px;padding:12px 28px;border-radius:60px;font-size:12px;font-weight:700;border:none;cursor:pointer;text-decoration:none;transition:all 0.15s}
    .gate-btn.primary{background:#d97706;color:#fff;box-shadow:0 4px 16px rgba(217,119,6,0.25)}
    .gate-btn.primary:hover{background:#b45309;transform:translateY(-1px);box-shadow:0 6px 24px rgba(217,119,6,0.3)}
    .gate-btn.secondary{background:transparent;color:#6B7280;font-size:10px;font-weight:600;padding:8px 16px}
    .gate-btn.secondary:hover{color:#374151}
    .gate-divider{height:1px;background:#ede4d8;margin:16px 0}
    .gate-footer{font-size:9px;color:#9CA3AF;font-weight:500}
    .gate-footer a{color:#d97706;font-weight:700;text-decoration:none}
    .gate-footer a:hover{text-decoration:underline}
    .price-tag{font-size:28px;font-weight:900;color:#1F2937;letter-spacing:-0.02em}
    .price-tag small{font-size:12px;font-weight:500;color:#6B7280}
    .saved-badge{position:fixed;bottom:24px;right:24px;z-index:10000;background:#059669;color:#fff;font-size:9px;font-weight:700;padding:6px 14px;border-radius:20px;box-shadow:0 2px 12px rgba(5,150,105,0.25);opacity:0;transition:opacity 0.3s;pointer-events:none}
    .saved-badge.show{opacity:1}
    .dp-toolbar .dp-nav-label{color:#6b5f51!important}
  </style>
</head>
<body>
  <div id="app-container"></div>

  <div id="purchase-gate">
    <div class="gate-card">
      <div class="app-icon">🎯</div>
      <h1>Goal Roadmap</h1>
      <p class="sub">Your Life Planning System</p>
      <p class="desc">A complete life planning system combining goal setting, career roadmapping, finance planning, vision boarding, and quarterly reviews — all in one live web app.</p>
      <div class="features">
        <span>Life Vision Board — design your ideal future across 6 domains</span>
        <span>SMART Goal Worksheet — break big dreams into actionable steps</span>
        <span>90-Day Execution Sprint — 3-sprint system with weekly actions</span>
        <span>Career Roadmap — skill tracking with milestone checkpoints</span>
        <span>50/30/20 Budget Planner — income, expenses, savings tracking</span>
        <span>Quarterly Review — audit progress, adjust strategy</span>
      </div>
      <div style="margin-bottom:16px">
        <span class="price-tag">$12.00 <small>one-time</small></span>
        <div style="font-size:9px;color:#059669;font-weight:700;margin-top:4px">✓ 30-day money-back guarantee</div>
      </div>
      <a href="/digital-store/goal-roadmap#customize" class="gate-btn primary">Get Instant Access →</a>
      <div class="gate-divider"></div>
      <p class="gate-footer">Already purchased? <a href="#" id="unlock-btn">Click here to unlock</a></p>
      <div style="margin-top:8px">
        <button class="gate-btn secondary" id="preview-btn">Show me a preview first</button>
      </div>
    </div>
  </div>

  <div class="saved-badge" id="saved-badge">✓ Saved</div>

  <script>
  import { DigitalPlanner } from "../../scripts/planner-engine/digital-planner";
  import { GoalRoadmapPreview, getTheme } from "../../scripts/planner-engine/goal-roadmap-renderer";

  (function(){
    const SLUG = 'goal-roadmap';
    const STORAGE_KEY = 'tt_purchased_' + SLUG;

    function isPurchased() {
      try { return localStorage.getItem(STORAGE_KEY) === 'true'; } catch(e) { return false; }
    }

    var container = document.getElementById('app-container');
    var gate = document.getElementById('purchase-gate');

    function initApp() {
      if (container.__dp_mounted) return;
      container.__dp_mounted = true;

      const dp = new DigitalPlanner(
        container,
        {},
        getTheme('amber'),
        'Goal Roadmap',
        '🎯',
        {
          sidebar: true,
          getPages: function(v: any, t: any, title?: string, icon?: string) {
            var preview = new GoalRoadmapPreview(v, t, title, icon);
            return preview.getPageList();
          }
        }
      );
      dp.mount();

      setTimeout(function() {
        var title = container.querySelector('.digital-planner-sidebar-title');
        if (title) title.innerHTML = '🎯 Goal Roadmap';
      }, 0);
    }

    if (isPurchased()) {
      gate.classList.remove('show');
      gate.style.display = 'none';
      initApp();
    } else {
      gate.classList.add('show');
      initApp();
      container.classList.add('gated');
    }

    document.getElementById('unlock-btn').addEventListener('click', function(e) {
      e.preventDefault();
      try { localStorage.setItem(STORAGE_KEY, 'true'); } catch(e) {}
      gate.classList.remove('show');
      gate.style.display = 'none';
      container.classList.remove('gated');
      var badge = document.getElementById('saved-badge');
      if (badge) { badge.textContent = '✓ Unlocked'; badge.classList.add('show');
        clearTimeout(badge._hide); badge._hide = setTimeout(function() { badge.classList.remove('show'); }, 2000); }
    });

    var previewActive = false;
    document.getElementById('preview-btn').addEventListener('click', function() {
      if (!previewActive) {
        gate.style.display = 'none';
        container.classList.remove('gated');
        previewActive = true;
        this.textContent = 'Back to purchase';
      } else {
        gate.style.display = 'flex';
        container.classList.add('gated');
        previewActive = false;
        this.textContent = 'Show me a preview first';
      }
    });
  })();
  </script>
</body>
</html>
