---
import Layout from "../layouts/Layout.astro";
import DateDurationCalculator from "../components/calculators/DateDurationCalculator.astro";
import FAQ from "../components/ui/FAQ.astro";
import HowToUseModal from "../components/ui/HowToUseModal.astro";

const howToUseSteps = [
  {
    title: "Enter Start Date",
    description: "Input the starting day, month, and year."
  },
  {
    title: "Enter End Date",
    description: "Input the target ending day, month, and year."
  },
  {
    title: "Calculate Time Span",
    description: "Click \"Calculate Duration\" to compute the exact elapsed time in years, months, and days."
  }
];
const howToUseTip = "Click \"Reset\" to clear both dates and start a new calculation.";

const faqItems = [
  {
    question: "What is the Date Duration Calculator?",
    answer: "This tool calculates the total time between any two dates. It's useful for project planning, tracking historical events, or seeing how much time has passed between two milestones."
  },
  {
    question: "Does it include the end date?",
    answer: "Our calculator finds the difference between two dates. By default, it calculates the 'duration' which is the time elapsed from the start to the end date."
  },
  {
    question: "Can I calculate duration in weeks?",
    answer: "Currently, our results provide a breakdown in years, months, and days. We are working on adding total weeks and other units soon."
  },
  {
    question: "Is my date data private?",
    answer: "Yes. All calculation logic runs locally in your web browser. Neither date is transmitted to external servers."
  }
];

const canonicalUrl = "https://tooltails.com/duration/";
---

<Layout 
  title="Date Duration Calculator — Calculate Time Between Two Dates" 
  description="Calculate the exact duration between any two dates in years, months, and days. Free, instant, and 100% browser-based date duration tool."
>
  <!-- Hero Section -->
  <section class="px-4 sm:px-6 pt-4 pb-2">
    <div class="max-w-7xl mx-auto flex flex-col gap-3">
      <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink mb-1.5 leading-tight">
            Date Duration Calculator — Calculate Time Between Two Dates
          </h1>
          <p class="text-body text-sm max-w-2xl leading-relaxed">
            Need to know exactly how much time is between two dates? Use our precision tool to calculate years, months, and days between any two points in time.
          </p>
        </div>
        <div class="shrink-0 self-start sm:self-auto">
          <HowToUseModal toolName="Date Duration Calculator" steps={howToUseSteps} tip={howToUseTip} />
        </div>
      </div>

      <div class="w-full">
        <DateDurationCalculator />
      </div>

      <!-- Trust Signals -->
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 mt-6 text-[11px] font-bold text-mute uppercase tracking-widest">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-link"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Privacy First (Client-Side)
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-link"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          Calendar Accurate
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-link"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
          100% Free
        </span>
      </div>
    </div>
  </section>

  <!-- Comprehensive Explanatory Section -->
  <section class="px-4 sm:px-6 py-12 bg-canvas border-t border-hairline">
    <div class="max-w-7xl mx-auto space-y-12">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">How Date Duration Works</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <p class="text-body leading-relaxed text-base mb-4 max-w-3xl">
          Measuring the duration between two dates requires evaluating the chronological distance between a start date and an end date. Depending on whether you need conversational calendar units or rigorous mathematical duration, date calculation uses two distinct methodologies: <strong>calendar borrowing decomposition</strong> and <strong>absolute epoch duration</strong>.
        </p>
        <p class="text-body leading-relaxed text-base max-w-3xl">
          Our calculator delivers both perspectives. It breaks elapsed time down into intuitive full years, remaining months, and remaining days, while also calculating cumulative metrics. If you specifically need to compare the chronological gap between two individuals' birth dates, check our dedicated <a href="/age-difference/" class="text-link font-medium hover:underline">age difference calculator</a>, or calculate personal longevity metrics with the <a href="/age-calculator/" class="text-link font-medium hover:underline">exact age calculator</a>.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-7 h-7 rounded-full bg-link/10 text-link flex items-center justify-center shadow-inner text-xs font-bold">1</div>
            <h3 class="text-base font-bold text-ink group-hover:text-link transition-colors">Calendar Decomposition vs. Epoch Math</h3>
          </div>
          <p class="text-sm text-body leading-relaxed">
            Calendar decomposition mimics how humans speak about time (e.g., "3 years, 2 months, and 10 days"). Absolute epoch duration calculates the exact physical time between two timestamps (in milliseconds) and divides by 86,400,000 to derive true elapsed days without distortion from varying month lengths.
          </p>
        </div>
        <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-7 h-7 rounded-full bg-link/10 text-link flex items-center justify-center shadow-inner text-xs font-bold">2</div>
            <h3 class="text-base font-bold text-ink group-hover:text-link transition-colors">The Fencepost Problem</h3>
          </div>
          <p class="text-sm text-body leading-relaxed">
            In standard date arithmetic, the duration between May 1 and May 3 is 2 days (exclusive of one boundary). However, for event schedules or hotel stays, inclusive counting includes both the start date and end date (3 calendar days). Understanding which convention your project requires prevents contract disputes.
          </p>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Calendar Days vs. Business Days</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <div class="w-10 h-10 rounded-2xl bg-link/10 text-link flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3 class="text-base font-bold text-ink mb-2 group-hover:text-link transition-colors">Calendar Days (Civil Time)</h3>
            <p class="text-sm text-body leading-relaxed">
              Includes every 24-hour cycle regardless of weekends or holidays. Essential for biological processes, visa expiration periods, statutory statute of limitations, and interest accrual.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <div class="w-10 h-10 rounded-2xl bg-link/10 text-link flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </div>
            <h3 class="text-base font-bold text-ink mb-2 group-hover:text-link transition-colors">Business Days (Working Time)</h3>
            <p class="text-sm text-body leading-relaxed">
              Excludes Saturdays, Sundays, and public bank holidays. In a typical month of 30 calendar days, only 20 to 22 days are productive business working days.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-sm transition-all hover:shadow-md group">
            <div class="w-10 h-10 rounded-2xl bg-link/10 text-link flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            </div>
            <h3 class="text-base font-bold text-ink mb-2 group-hover:text-link transition-colors">Leap Year Traversal</h3>
            <p class="text-sm text-body leading-relaxed">
              Spans crossing February in a leap year automatically account for the 366th day, guaranteeing that cumulative daily intervals remain mathematically exact.
            </p>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Common Practical Applications</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-canvas border border-hairline rounded-3xl p-6 shadow-sm transition-all hover:shadow-md group">
            <h3 class="font-bold text-ink mb-2 text-sm group-hover:text-link transition-colors">Contracts & Leases</h3>
            <p class="text-xs text-body leading-relaxed">
              Verify exact elapsed time for commercial lease agreements, 30-day return policies, and 90-day warranty coverage.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 shadow-sm transition-all hover:shadow-md group">
            <h3 class="font-bold text-ink mb-2 text-sm group-hover:text-link transition-colors">Visas & Travel</h3>
            <p class="text-xs text-body leading-relaxed">
              Calculate exact days remaining under tourist visas or Schengen area 90/180-day stay restrictions.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 shadow-sm transition-all hover:shadow-md group">
            <h3 class="font-bold text-ink mb-2 text-sm group-hover:text-link transition-colors">Project Sprints</h3>
            <p class="text-xs text-body leading-relaxed">
              Software engineering teams and project managers measure exact sprint durations and milestone intervals.
            </p>
          </div>
          <div class="bg-canvas border border-hairline rounded-3xl p-6 shadow-sm transition-all hover:shadow-md group">
            <h3 class="font-bold text-ink mb-2 text-sm group-hover:text-link transition-colors">Historical Research</h3>
            <p class="text-xs text-body leading-relaxed">
              Historians and genealogists evaluate exact elapsed time between pivotal historical events and family timelines.
            </p>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Comparison of Measurement Units</h3>
          <div class="h-px w-full bg-hairline"></div>
        </div>
        <div class="bg-canvas border border-hairline rounded-3xl overflow-hidden shadow-sm">
          <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-canvas-soft border-b border-hairline text-ink font-semibold">
              <tr>
                <th class="p-4 sm:p-5 text-xs font-extrabold uppercase tracking-wider text-mute">Measurement Metric</th>
                <th class="p-4 sm:p-5 text-xs font-extrabold uppercase tracking-wider text-mute">Underlying Calculation Logic</th>
                <th class="p-4 sm:p-5 text-xs font-extrabold uppercase tracking-wider text-mute">Best Practical Application</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline text-body">
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Years, Months, & Days</td>
                <td class="p-4 sm:p-5">Gregorian calendar borrowing algorithm</td>
                <td class="p-4 sm:p-5">Biographical timelines, age differences, and general conversation</td>
              </tr>
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Total Elapsed Days</td>
                <td class="p-4 sm:p-5">Exact timestamp delta divided by 86,400,000 ms</td>
                <td class="p-4 sm:p-5">Legal notice periods, immigration visa limits, and scientific logging</td>
              </tr>
              <tr class="hover:bg-canvas-soft/40 transition-colors">
                <td class="p-4 sm:p-5 font-bold text-ink">Total Elapsed Weeks</td>
                <td class="p-4 sm:p-5">Integer division of total days divided by 7</td>
                <td class="p-4 sm:p-5">Academic terms, fitness training blocks, and construction cycles</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Tools -->
  <section class="px-4 sm:px-6 py-12 bg-canvas border-b border-hairline">
    <div class="max-w-7xl mx-auto text-center">
      <div class="flex items-center gap-3 mb-8">
        <div class="h-px w-full bg-hairline"></div>
        <h3 class="text-[11px] font-bold text-mute uppercase tracking-widest whitespace-nowrap">Explore Companion Tools</h3>
        <div class="h-px w-full bg-hairline"></div>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/age-calculator/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Exact Age Calculator
        </a>
        <a href="/age-difference/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Age Difference Calculator
        </a>
        <a href="/future-age/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Future Age Calculator
        </a>
        <a href="/birthday-countdown/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Birthday Countdown
        </a>
        <a href="/word-counter/" class="inline-flex items-center justify-center px-5 h-11 text-xs sm:text-sm font-semibold rounded-full bg-canvas text-ink border border-hairline hover:bg-canvas-soft-2 hover:border-link/40 hover:text-link hover:shadow-sm transition-all active:scale-[0.98]">
          Word Counter
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="px-4 sm:px-6 py-16">
    <div class="max-w-4xl mx-auto">
      <FAQ items={faqItems} renderSchema={false} />
    </div>
  </section>

  <!-- Structured Data (Unified Graph) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Tooltails", "item": "https://tooltails.com/" },
          { "@type": "ListItem", "position": 2, "name": "Date Duration Calculator", "item": canonicalUrl }
        ]
      },
      {
        "@type": "WebApplication",
        "name": "Date Duration Calculator",
        "url": canonicalUrl,
        "description": "Calculate the exact duration between any two dates in years, months, and days.",
        "applicationCategory": "UtilityApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript"
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      }
    ]
  })} />
</Layout>

