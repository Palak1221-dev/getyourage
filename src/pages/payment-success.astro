---
import Layout from "../layouts/Layout.astro";
import { isSmtpConfigured } from "../lib/email";

const smtpEnabled = isSmtpConfigured();
---

<Layout
  title="Payment Successful — Tooltails Store"
  description="Your payment was successful. Download your personalized planner."
  robots="noindex, nofollow"
>
  <div class="min-h-screen bg-[#FAF9FC] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg mx-auto text-center space-y-8">

      <!-- Success Icon -->
      <div class="w-20 h-20 bg-emerald-50 border-2 border-emerald-200 rounded-full flex items-center justify-center text-4xl mx-auto shadow-lg shadow-emerald-100/50">
        <span class="text-emerald-600">✓</span>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 font-serif tracking-tight">
          Payment Successful
        </h1>
        <p class="text-sm text-stone-500 font-medium max-w-md mx-auto">
          Thank you for your purchase! Your personalized planner is being prepared.
        </p>
      </div>

      <!-- Order Details Card -->
      <div class="bg-white rounded-2xl border border-stone-200/80 p-6 shadow-xs space-y-4 text-left" id="order-details">
        
        <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-purple-50 border border-purple-100 mx-auto mb-2">
          <svg class="w-6 h-6 text-[#7C3AED]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>

        <div id="order-loading" class="text-center py-8 space-y-3">
          <div class="w-8 h-8 border-2 border-[#7C3AED] border-t-transparent rounded-full animate-spin mx-auto"></div>
          <p class="text-xs font-medium text-stone-500">Verifying your payment...</p>
        </div>

        <div id="order-content" class="hidden space-y-4">
          <div class="border-b border-stone-100 pb-3">
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Order Number</p>
            <p id="order-id" class="text-sm font-bold text-stone-900 font-mono mt-0.5">---</p>
          </div>

          <div class="border-b border-stone-100 pb-3">
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Product</p>
            <p id="order-product" class="text-sm font-bold text-stone-900 mt-0.5">---</p>
          </div>

          <div class="border-b border-stone-100 pb-3">
            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Email</p>
            <p id="order-email" class="text-sm font-medium text-stone-600 mt-0.5">---</p>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <span class="w-5 h-5 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center flex-shrink-0">
              <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            <span class="text-xs font-medium text-stone-600">
              {smtpEnabled
                ? 'A receipt has been sent to your email.'
                : 'Your payment was successful.'}
            </span>
          </div>
        </div>

        <div id="order-error" class="hidden text-center py-6 space-y-3">
          <p class="text-sm font-bold text-stone-700">Could not load order details</p>
          <p class="text-xs text-stone-500">Your order is still being processed. You'll receive an email confirmation shortly.</p>
        </div>

      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a id="download-planner-btn" href="/digital-store" class="px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-lg shadow-emerald-600/20 hover:shadow-2xl transition-all flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
          <span id="download-btn-text">Download Your Planner</span>
        </a>
        <a href="/digital-store" class="px-8 py-4 rounded-full bg-white hover:bg-stone-50 text-stone-700 border border-stone-200 font-bold text-sm transition-all flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path d="M3 12h18M12 3l9 9-9 9"/>
          </svg>
          Continue Shopping
        </a>
      </div>

      <!-- Support -->
      <p class="text-xs text-stone-400 font-medium">
        Need help? <a href="/contact" class="text-[#7C3AED] font-bold hover:underline">Contact Support</a>
      </p>

    </div>
  </div>

  <script>
    (async function() {
      const params = new URLSearchParams(window.location.search);
      const sessionId = params.get('session_id') || params.get('sessionId') || '';
      const status = params.get('status') || '';
      const paymentId = params.get('payment_id') || params.get('paymentId') || '';
      const productSlug = params.get('product_slug') || params.get('slug') || '';

      const loadingEl = document.getElementById('order-loading');
      const contentEl = document.getElementById('order-content');
      const errorEl = document.getElementById('order-error');
      const downloadBtn = document.getElementById('download-planner-btn') as HTMLAnchorElement;
      const downloadBtnText = document.getElementById('download-btn-text');

      let customerEmail = '';

      if (!sessionId && !paymentId) {
        if (loadingEl) loadingEl.classList.add('hidden');
        if (contentEl) {
          document.getElementById('order-id')!.textContent = 'Completed';
          contentEl.classList.remove('hidden');
        }
        if (downloadBtn) {
          downloadBtn.href = '/digital-store';
        }
        return;
      }

      try {
        const resp = await fetch('/api/verify-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            paymentId: paymentId || undefined,
            sessionId: sessionId || undefined,
          }),
        });

        const result = await resp.json();
        customerEmail = result.customerEmail || '';

        if (loadingEl) loadingEl.classList.add('hidden');

        if (result.verified) {
          const displayOrderId = result.orderId || result.paymentId || 'Completed';
          document.getElementById('order-id')!.textContent = displayOrderId;
          document.getElementById('order-product')!.textContent = 'Your Personalized Planner';
          document.getElementById('order-email')!.textContent = result.customerEmail || 'Check your email';
          if (contentEl) contentEl.classList.remove('hidden');
          if (downloadBtn && result.orderId) {
            downloadBtn.href = `/download/${encodeURIComponent(result.orderId)}`;
          }
        } else {
          if (contentEl) contentEl.classList.remove('hidden');
          document.getElementById('order-id')!.textContent = paymentId || sessionId || 'Completed';
        }
      } catch (err) {
        if (loadingEl) loadingEl.classList.add('hidden');
        if (errorEl) errorEl.classList.remove('hidden');
        if (contentEl) contentEl.classList.remove('hidden');
        document.getElementById('order-id')!.textContent = paymentId || sessionId || 'Completed';
      }

      try {
        localStorage.removeItem('tt_cart');
        if (productSlug && customerEmail) {
          try {
            await fetch('/api/access/unlock', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: customerEmail, slug: productSlug }),
            });
          } catch (e) {}
        }
      } catch (e) {}
    })();
  </script>
</Layout>
